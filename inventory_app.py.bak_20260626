# ========== ユーティリティ ==========
def parse_jp_date(s, year=2026):
    """「4月17日」「2026/4/17」などをdateに変換"""
    if pd.isna(s):
        return None
    s = str(s).strip()
    try:
        if '月' in s and '日' in s:
            m = s.replace('日', '').split('月')
            return datetime.date(year, int(m[0]), int(m[1]))
        if '/' in s:
            parts = s.split('/')
            return datetime.date(int(parts[0]), int(parts[1]), int(parts[2]))
        if '-' in s:
            return datetime.date.fromisoformat(s)
    except (ValueError, IndexError):
        return None
    return None


def load_csv_from_upload(uploaded_file):
    """アップロードされたCSVをDataFrameに変換"""
    df = pd.read_csv(uploaded_file, encoding='utf-8-sig')
    df.columns = [c.strip() for c in df.columns]
    for c in df.columns:
        if df[c].dtype == 'object':
            df[c] = df[c].astype(str).str.strip()
    for c in df.columns:
        if 'JAN' in c:
            df[c] = df[c].astype(str).str.strip()
    return df


def detect_file_kind(df):
    """DataFrameの列名から、どのファイルかを推測"""
    cols = set(df.columns)
    if {'原料JAN', '入数', '原料区分'}.issubset(cols):
        return 'material'
    if {'原料JAN', '原料名', '使用量'}.issubset(cols) and 'JAN' in cols:
        return 'recipe'
    if '棚卸日' in cols and '棚卸数' in cols:
        return 'inventory'
    if '製造数' in cols:
        return 'actual_prod'
    if '計画数' in cols:
        return 'plan'
    if '仕入計上数' in cols:
        return 'actual_del'
    if '納品予定数' in cols:
        return 'plan_del'
    return None


# ========== 計算ロジック ==========
def calculate_flow(
    store_name,
    inv_s, plan_s, aprod_s, pdel_s, adel_s,
    recipe_df, material_df,
    target_date, base_days, yield_fusoku, yield_kasoku,
    adjustments=None,  # ズレ補正：{原料JAN: 補正値} の辞書
):
    """指定店舗・指定パラメータで在庫推移を計算
    
    adjustments: 該当店舗の {原料JAN: 補正値} 辞書。期首在庫に加算される。
    """
    inv_s = inv_s[inv_s['店舗名'] == store_name].copy() if len(inv_s) > 0 else inv_s
    plan_s = plan_s[plan_s['店舗名'] == store_name].copy() if len(plan_s) > 0 else plan_s
    aprod_s = aprod_s[aprod_s['店舗名'] == store_name].copy() if len(aprod_s) > 0 else aprod_s
    pdel_s = pdel_s[pdel_s['店舗名'] == store_name].copy() if len(pdel_s) > 0 else pdel_s
    adel_s = adel_s[adel_s['店舗名'] == store_name].copy() if len(adel_s) > 0 else adel_s
    
    if len(inv_s) == 0 or inv_s['棚卸日_d'].dropna().empty:
        return pd.DataFrame()
    opening_date = inv_s['棚卸日_d'].dropna().max()
    
    plan_dates = plan_s['日付_d'].dropna()
    if plan_dates.empty:
        return pd.DataFrame()
    end_date = plan_dates.max()
    
    date_range = []
    cur = opening_date + datetime.timedelta(days=1)
    while cur <= end_date:
        date_range.append(cur)
        cur += datetime.timedelta(days=1)
    
    material_idx = material_df.set_index('原料JAN')
    
    recipe_by_material = {}
    for _, r in recipe_df.iterrows():
        m_jan = r['原料JAN']
        recipe_by_material.setdefault(m_jan, []).append((r['JAN'], float(r['使用量'])))
    
    inv_opening = inv_s[inv_s['棚卸日_d'] == opening_date].copy()
    opening_dict = inv_opening.groupby('JAN')['棚卸数'].sum().to_dict()
    
    # ズレ補正を期首在庫に加算
    if adjustments:
        for jan, adj_val in adjustments.items():
            if adj_val:  # 0以外の補正値のみ反映
                current = opening_dict.get(jan, 0.0)
                opening_dict[jan] = current + float(adj_val)
    
    target_jans = set(opening_dict.keys())
    target_jans |= set(recipe_by_material.keys())
    if len(pdel_s) > 0:
        target_jans |= set(pdel_s['JAN'].dropna().unique())
    if len(adel_s) > 0:
        target_jans |= set(adel_s['JAN'].dropna().unique())
    target_jans &= set(material_idx.index)
    
    plan_dict = {}
    for _, p in plan_s.iterrows():
        plan_dict[(p['JAN'], p['日付_d'])] = plan_dict.get((p['JAN'], p['日付_d']), 0) + float(p['計画数'])
    
    aprod_dict = {}
    for _, p in aprod_s.iterrows():
        aprod_dict[(p['JAN'], p['日付_d'])] = aprod_dict.get((p['JAN'], p['日付_d']), 0) + float(p['製造数'])
    
    pdel_dict = {}
    for _, d in pdel_s.iterrows():
        pdel_dict[(d['JAN'], d['納品予定日_d'])] = pdel_dict.get((d['JAN'], d['納品予定日_d']), 0) + float(d['納品予定数'])
    
    adel_dict = {}
    for _, d in adel_s.iterrows():
        adel_dict[(d['JAN'], d['納品予定日_d'])] = adel_dict.get((d['JAN'], d['納品予定日_d']), 0) + float(d['仕入計上数'])
    
    rows = []
    for m_jan in target_jans:
        m_info = material_idx.loc[m_jan]
        if isinstance(m_info, pd.DataFrame):
            m_info = m_info.iloc[0]
        
        m_name = m_info['原料名']
        try:
            nyusu = float(m_info['入数'])
        except (ValueError, TypeError):
            nyusu = 1
        if nyusu == 0:
            nyusu = 1
        
        kubun = m_info.get('原料区分', '')
        target_kbn = m_info.get('対象区分', '')
        is_houzai = kubun in HOUZAI_KUBUN
        
        uses = recipe_by_material.get(m_jan, [])
        
        remain = float(opening_dict.get(m_jan, 0.0))
        usage_history = []
        
        for d in date_range:
            if target_date is not None and d <= target_date:
                in_qty = adel_dict.get((m_jan, d), 0.0)
                source_dict = aprod_dict
            else:
                in_qty = pdel_dict.get((m_jan, d), 0.0)
                source_dict = plan_dict
            
            out_qty = 0.0
            for prod_jan, usage_per_item in uses:
                qty = source_dict.get((prod_jan, d), 0.0)
                if qty > 0:
                    used_raw = qty * usage_per_item
                    if is_houzai:
                        out_qty += used_raw
                    else:
                        out_qty += used_raw / nyusu
            
            remain = remain + in_qty - out_qty
            usage_history.append(out_qty)
            
            recent = usage_history[-base_days:] if len(usage_history) >= base_days else usage_history
            if sum(recent) > 0:
                avg_use = sum(recent) / len(recent)
                yf = yield_fusoku if target_kbn == '不測' else yield_kasoku
                safety = avg_use / yf * base_days
            else:
                safety = 0.0
            
            diff = remain - safety
            
            rows.append({
                '原料JAN': m_jan,
                '原料名': m_name,
                '原料区分': kubun,
                '対象区分': target_kbn,
                '入数': nyusu,
                '日付': d,
                '入': round(in_qty, 3),
                '出': round(out_qty, 3),
                '残': round(remain, 3),
                '安全在庫': round(safety, 3),
                '差': round(diff, 3),
            })
    
    return pd.DataFrame(rows)


# ==========================================================
# 原料区分の業務的並び順（2026/5/14 確認、2026/5/18 共通化）
# ==========================================================
# 並び順の規則：
#   1. 原料Noあり区分：min(原料No) の昇順（ご飯→サーモン→マグロ…）
#   2. 原料Noなし区分（野菜・包材(内装)など）：区分名のアルファベット昇順
#   3. 包材(本体)：末尾から2番目
#   4. 包材（蓋）：最末尾
# 用途：棚卸評価タブ、エリア在庫タブ、原料ピックアップタブ等で共通使用。
def get_sorted_material_categories(material_df, exclude_target_gai=True):
    """原料区分を業務的並び順で返す。

    Args:
        material_df (pd.DataFrame): 原料マスタ。列に '原料区分' と（必要に応じて）
            '原料No'、'対象区分' を含む。
        exclude_target_gai (bool): True なら '対象区分=対象外' を除外した結果を返す。

    Returns:
        list[str]: 業務的並び順で並べた原料区分名のリスト。
    """
    mat = material_df.copy()
    if exclude_target_gai and '対象区分' in mat.columns:
        mat = mat[mat['対象区分'] != '対象外']
    if '原料No' in mat.columns:
        mat['原料No_int'] = pd.to_numeric(mat['原料No'], errors='coerce')
    else:
        mat['原料No_int'] = pd.NA

    kubun_min_no = mat.groupby('原料区分')['原料No_int'].min(numeric_only=True).to_dict()
    max_no = mat['原料No_int'].max(skipna=True)
    if pd.isna(max_no):
        max_no = 0
    BODY_KEY = '包材(本体)'
    LID_KEY = '包材（蓋）'

    # NaN系区分（包材本体・蓋以外）を区分名アルファベット順で並べる
    nan_kubuns = sorted([k for k, v in kubun_min_no.items()
                         if pd.isna(v) and k not in (BODY_KEY, LID_KEY)])
    nan_kubun_order = {k: max_no + 100 + i for i, k in enumerate(nan_kubuns)}

    def category_order(k):
        if k == BODY_KEY:
            return max_no + 9999
        if k == LID_KEY:
            return max_no + 10000
        if k in nan_kubun_order:
            return nan_kubun_order[k]
        v = kubun_min_no.get(k)
        if pd.isna(v):
            return max_no + 99
        return v

    return sorted(kubun_min_no.keys(), key=category_order)


# ==========================================================
# 棚卸評価ロジック（2026/5/14 追加）
# ==========================================================
# 業務的目的：棚卸結果と論理在庫の乖離を評価し、原料ごとに ◎○△× を付ける。
#   論理在庫 = max(0, 前回棚卸 + 期間内納品 - 期間内使用量)
#   差        = 実在庫 - 論理在庫
#   |差|の絶対値で：◎≤5 / ○≤20 / △≤30 / ×>30
#
# また、各原料を「不動 / 過剰α / 過剰 / 不足」の分類でラベリングする：
#   不動    : 期間中の納品=0 かつ 使用量=0
#   過剰α  : 実在庫 ≥ 安全在庫×2
#   過剰    : 実在庫 ≥ 安全在庫
#   不足    : 実在庫 < 安全在庫
#   安全在庫 = base_days × 1日使用量
#   1日使用量 = 評価日から先1週間の計画ベースの使用予定量平均（⓪余裕日数と同じ）
def calculate_inventory_evaluation(store_name, target_date, loaded, base_days=3,
                                    yield_fusoku=0.7, yield_kasoku=0.9):
    """棚卸評価の計算。原料ごとに 論理/実/差/評価/分類 を出す。

    Args:
        store_name (str): 店舗名（例：'宇美店'）
        target_date (datetime.date): 評価対象の棚卸日
        loaded (dict): session_state.loaded（material/recipe/inventory/plan/actual_prod/actual_del）
        base_days (int): 安全在庫の基準日数（既定3日）
        yield_fusoku (float): 不測区分の歩留率（既定0.7、安全在庫=base_days×1日使用量÷歩留率）
        yield_kasoku (float): 可測区分の歩留率（既定0.9）

    Returns:
        pd.DataFrame: 列は 原料JAN, 原料名, 原料区分, 対象区分,
                            前回棚卸日, 前回棚卸数, 納品数, 使用量,
                            論理在庫, 実在庫, 差, |差|,
                            評価, 分類, 1日使用量, 安全在庫
        ※ 並び順は仕様通り：原料区分の最小No順、同区分内では原料No順、最後に包材
    """
    material = loaded['material']
    recipe = loaded['recipe']
    inventory = loaded['inventory']
    actual_prod = loaded['actual_prod']
    actual_del = loaded['actual_del']
    plan = loaded.get('plan', pd.DataFrame())

    # ---- Step 1: 原料リスト（対象区分=対象外を除外、ソート） ----
    mat = material.copy()
    mat['原料JAN'] = mat['原料JAN'].astype(str).str.strip()
    if '対象区分' in mat.columns:
        mat = mat[mat['対象区分'] != '対象外'].copy()
    mat['原料No_int'] = pd.to_numeric(mat.get('原料No'), errors='coerce')

    # 原料区分の業務的並び順を取得（共通関数、2026/5/18 共通化）
    sorted_categories = get_sorted_material_categories(material, exclude_target_gai=True)
    cat_order_map = {cat: i for i, cat in enumerate(sorted_categories)}
    # mat の各行に区分の並び順を付与（未知区分は末尾）
    mat['_kubun_order'] = mat['原料区分'].map(cat_order_map).fillna(len(sorted_categories) + 1)
    mat = mat.sort_values(['_kubun_order', '原料No_int', '原料名'], na_position='last').reset_index(drop=True)

    mat_idx = mat.drop_duplicates('原料JAN').set_index('原料JAN')

    # ---- Step 2: 前回棚卸 / 今回棚卸 ----
    inv = inventory.copy()
    inv['原料JAN'] = inv['原料JAN'].astype(str).str.strip()
    inv['棚卸数_num'] = pd.to_numeric(inv['棚卸数'], errors='coerce').fillna(0.0)
    inv_store = inv[inv['店舗名'] == store_name].copy()

    today_inv = inv_store[inv_store['棚卸日_d'] == target_date]
    today_dict = dict(zip(today_inv['原料JAN'], today_inv['棚卸数_num']))

    prev_inv = inv_store[inv_store['棚卸日_d'] < target_date]
    if len(prev_inv) > 0:
        prev_inv_date = prev_inv['棚卸日_d'].max()
        prev_rows = prev_inv[prev_inv['棚卸日_d'] == prev_inv_date]
        prev_dict = dict(zip(prev_rows['原料JAN'], prev_rows['棚卸数_num']))
        start_date = prev_inv_date + datetime.timedelta(days=1)
    else:
        prev_inv_date = None
        prev_dict = {}
        start_date = None  # 前回なしなら期間集計はスキップ
    end_date = target_date

    # ---- Step 2.5: 評価対象を「実棚卸データに登場する原料」に絞り込み（2026/5/15）----
    # 業務的解釈：棚卸評価は実カウントされた原料の論理 vs 実の乖離を見るのが目的。
    # 一度もカウントされていない原料は評価対象外（対象区分=対象外と同様、表示から除外）。
    target_jans = set(today_dict.keys()) | set(prev_dict.keys())
    mat = mat[mat['原料JAN'].isin(target_jans)].reset_index(drop=True)
    mat_idx = mat.drop_duplicates('原料JAN').set_index('原料JAN')

    # ---- Step 3a: 期間内納品数（actual_del） ----
    delivery_dict = {}
    if start_date is not None and len(actual_del) > 0:
        adel = actual_del.copy()
        adel['JAN'] = adel['JAN'].astype(str).str.strip()
        adel['仕入計上数_num'] = pd.to_numeric(adel['仕入計上数'], errors='coerce').fillna(0.0)
        adel_p = adel[
            (adel['店舗名'] == store_name)
            & (adel['納品予定日_d'] >= start_date)
            & (adel['納品予定日_d'] <= end_date)
        ]
        delivery_dict = adel_p.groupby('JAN')['仕入計上数_num'].sum().to_dict()

    # ---- Step 3b: 期間内使用量（actual_prod × recipe 展開） ----
    rec = recipe.copy()
    rec['JAN'] = rec['JAN'].astype(str).str.strip()
    rec['原料JAN'] = rec['原料JAN'].astype(str).str.strip()
    rec['使用量_num'] = pd.to_numeric(rec['使用量'], errors='coerce').fillna(0.0)

    usage_dict = {}
    if start_date is not None and len(actual_prod) > 0:
        aprod = actual_prod.copy()
        aprod['JAN'] = aprod['JAN'].astype(str).str.strip()
        aprod['製造数_num'] = pd.to_numeric(aprod['製造数'], errors='coerce').fillna(0.0)
        aprod_p = aprod[
            (aprod['店舗名'] == store_name)
            & (aprod['日付_d'] >= start_date)
            & (aprod['日付_d'] <= end_date)
        ]
        prod_qty = aprod_p.groupby('JAN')['製造数_num'].sum().to_dict()
        for _, r in rec.iterrows():
            qty = prod_qty.get(r['JAN'], 0.0)
            if qty == 0 or r['使用量_num'] == 0:
                continue
            total = qty * r['使用量_num']
            m_jan = r['原料JAN']
            if m_jan in mat_idx.index:
                m_info = mat_idx.loc[m_jan]
                kubun = m_info.get('原料区分', '')
                nyusu = pd.to_numeric(m_info.get('入数', 1), errors='coerce')
                if pd.isna(nyusu) or nyusu == 0:
                    nyusu = 1
            else:
                kubun, nyusu = '', 1
            u = total if kubun in HOUZAI_KUBUN else total / nyusu
            usage_dict[m_jan] = usage_dict.get(m_jan, 0.0) + u

    # ---- Step 4-6 の準備: 1日使用量（評価日から1週間の計画平均） ----
    daily_usage_dict = {}
    if len(plan) > 0:
        plan_df = plan.copy()
        plan_df['JAN'] = plan_df['JAN'].astype(str).str.strip()
        plan_df['計画数_num'] = pd.to_numeric(plan_df['計画数'], errors='coerce').fillna(0.0)
        week_end = target_date + datetime.timedelta(days=7)
        plan_p = plan_df[
            (plan_df.get('店舗名', store_name) == store_name)
            & (plan_df['日付_d'] >= target_date)
            & (plan_df['日付_d'] <= week_end)
        ] if '店舗名' in plan_df.columns else plan_df[
            (plan_df['日付_d'] >= target_date) & (plan_df['日付_d'] <= week_end)
        ]
        plan_qty = plan_p.groupby('JAN')['計画数_num'].sum().to_dict()
        for _, r in rec.iterrows():
            qty = plan_qty.get(r['JAN'], 0.0)
            if qty == 0 or r['使用量_num'] == 0:
                continue
            total = qty * r['使用量_num']
            m_jan = r['原料JAN']
            if m_jan in mat_idx.index:
                m_info = mat_idx.loc[m_jan]
                kubun = m_info.get('原料区分', '')
                nyusu = pd.to_numeric(m_info.get('入数', 1), errors='coerce')
                if pd.isna(nyusu) or nyusu == 0:
                    nyusu = 1
            else:
                kubun, nyusu = '', 1
            u = total if kubun in HOUZAI_KUBUN else total / nyusu
            daily_usage_dict[m_jan] = daily_usage_dict.get(m_jan, 0.0) + u
        daily_usage_dict = {k: v / 7.0 for k, v in daily_usage_dict.items()}

    # ---- Step 4-6 の本体: 各原料の論理・評価・分類 ----
    rows = []
    for _, m in mat.iterrows():
        m_jan = m['原料JAN']
        prev_stock = float(prev_dict.get(m_jan, 0.0))
        delivery = float(delivery_dict.get(m_jan, 0.0))
        usage = float(usage_dict.get(m_jan, 0.0))
        logical = max(0.0, prev_stock + delivery - usage)
        actual = float(today_dict.get(m_jan, 0.0))
        diff = actual - logical
        abs_diff = abs(diff)

        if abs_diff <= 5:
            eval_mark = '◎'
        elif abs_diff <= 20:
            eval_mark = '○'
        elif abs_diff <= 30:
            eval_mark = '△'
        else:
            eval_mark = '×'

        daily = float(daily_usage_dict.get(m_jan, 0.0))
        # 歩留率の処理（2026/5/18 修正）：松本君ロジックに合わせて歩留率で割る
        # 可測なら ÷0.9、不測なら ÷0.7（calculate_flow と同じ式）
        target_kbn = m.get('対象区分', '')
        yf = yield_fusoku if target_kbn == '不測' else yield_kasoku
        safety = (base_days * daily) / yf if yf > 0 else 0.0

        # 分類ロジック（2026/5/18 修正）：
        #   「実在庫＝不動＋アクティブ」が成立するように、'実在庫なし' を新カテゴリとして分離
        #   - 実在庫 ≤ 0：実在庫なし（カウント漏れの可能性）
        #   - 実在庫 > 0 かつ 納品=0 かつ 使用量=0：不動
        #   - 実在庫 > 0 かつ 活動あり：過剰/過剰α/不足（従来通り）
        if actual <= 0:
            classification = '実在庫なし'
        elif delivery == 0 and usage == 0:
            classification = '不動'
        elif safety <= 0:
            classification = '過剰'  # 安全在庫=0だが活動あり → 計算上は過剰扱い
        elif actual >= safety * 2:
            classification = '過剰α'
        elif actual >= safety:
            classification = '過剰'
        else:
            classification = '不足'

        rows.append({
            '原料JAN': m_jan,
            '原料名': m.get('原料名', ''),
            '原料区分': m.get('原料区分', ''),
            '対象区分': m.get('対象区分', ''),
            '前回棚卸日': prev_inv_date,
            '前回棚卸数': round(prev_stock, 3),
            '納品数': round(delivery, 3),
            '使用量': round(usage, 3),
            '論理在庫': round(logical, 3),
            '実在庫': round(actual, 3),
            '差': round(diff, 3),
            '|差|': round(abs_diff, 3),
            '評価': eval_mark,
            '分類': classification,
            '1日使用量': round(daily, 3),
            '安全在庫': round(safety, 3),
        })

    return pd.DataFrame(rows)


# ========== キャッシュ付きラッパー ==========
# calculate_flow は重い計算（多数の原料 × 多数の日付 × レシピ展開）なので、
# 同じ条件での再計算を避けるためキャッシュする。
#
# 設計方針：
#   - 引数はハッシュしやすいスカラー値だけにする（DataFrameを引数から外す）
#   - 元データは st.session_state.loaded から関数内で参照する
#   - adjustments は dict のままだとハッシュが不安定なので tuple 化してキー化
#   - データ再取込時は外部からキャッシュをクリアする（後段でst.cache_data.clearを呼ぶ）
@st.cache_data(show_spinner=False)
def _calculate_flow_cached_impl(
    store_name,
    target_date,
    base_days,
    yield_fusoku,
    yield_kasoku,
    adjustments_key,   # tuple of (jan, value) でキャッシュキーとして使う
    data_version,      # データ再取込のたびに変わる識別子（キャッシュ無効化用）
):
    """キャッシュ実体。data_version はキャッシュ無効化のためだけに使われる。"""
    loaded = st.session_state.loaded
    adjustments = dict(adjustments_key) if adjustments_key else {}
    return calculate_flow(
        store_name,
        loaded['inventory'], loaded['plan'], loaded['actual_prod'],
        loaded['plan_del'], loaded['actual_del'],
        loaded['recipe'], loaded['material'],
        target_date=target_date,
        base_days=base_days,
        yield_fusoku=yield_fusoku,
        yield_kasoku=yield_kasoku,
        adjustments=adjustments,
    )


def calculate_flow_cached(
    store_name, target_date, base_days, yield_fusoku, yield_kasoku, adjustments
):
    """calculate_flow のキャッシュ付き版（呼出側はこちらを使う）"""
    # adjustments を安定なキーに変換（dict はハッシュ不可 / tuple はハッシュ可）
    adj_key = tuple(sorted((adjustments or {}).items()))
    data_version = st.session_state.get('data_version', 0)
    return _calculate_flow_cached_impl(
        store_name, target_date, base_days, yield_fusoku, yield_kasoku,
        adj_key, data_version,
    )


# ==========================================================
# 📦 エリア在庫タブ用のラッパー（2026/5/18 追加）
# ==========================================================
# エリア（複数店舗）× 1原料 × 基準日〜+N日の在庫を集約。
# 内部で各店舗の calculate_flow_cached を 2 回呼ぶ：
#   - df_actual (target_date=params['target_date'])
#       → 論理在庫＆予測在庫の取得（📉計画推移・📋実績推移と同じ）
#   - df_plan   (target_date=None)
#       → 1日使用量の取得（⓪余裕日数 と同じ）
# 既存キャッシュが効くため、初回以外は高速。
def get_area_inventory_data(
    area_stores, material_jan, base_date,
    base_days, yield_fusoku, yield_kasoku, target_date,
    horizon_days=4, usage_window_days=7,
):
    """エリア内 N 店舗 × 1原料 × 基準日〜+horizon_days の在庫データを集約。

    Returns:
        pd.DataFrame: 列 = 店舗 / 最新棚卸日 / 実棚卸数 / 論理在庫 /
        当日 / +1日 / ... / +N日 / 1日使用量 / 余裕日数 / ステータス
    """
    inv = st.session_state.loaded['inventory']

    rows = []
    for store in area_stores:
        adj = get_adjustments_for_store(store)

        # 1. df_actual：target_date まで実績、それ以降計画
        df_act = calculate_flow_cached(
            store, target_date, base_days, yield_fusoku, yield_kasoku, adj,
        )
        # 2. df_plan：全期間計画ベース（⓪余裕日数 と同じソース）
        df_pln = calculate_flow_cached(
            store, None, base_days, yield_fusoku, yield_kasoku, adj,
        )

        # 該当原料に絞る（空DataFrame＝計算対象データなし のケースを保護）
        if '原料JAN' in df_act.columns:
            sub_act = df_act[df_act['原料JAN'] == material_jan]
        else:
            sub_act = pd.DataFrame(columns=['日付', '残', '出'])
        if '原料JAN' in df_pln.columns:
            sub_pln = df_pln[df_pln['原料JAN'] == material_jan]
        else:
            sub_pln = pd.DataFrame(columns=['日付', '残', '出'])

        # 基準日 〜 +horizon の「残」を取得
        forecasts = []
        for d in range(horizon_days + 1):
            target = base_date + datetime.timedelta(days=d)
            v = sub_act.loc[sub_act['日付'] == target, '残']
            forecasts.append(float(v.iloc[0]) if len(v) > 0 else None)

        # 1日使用量（df_pln から、基準日〜+usage_window）= ⓪余裕日数 と同じロジック
        week_end = base_date + datetime.timedelta(days=usage_window_days)
        usage_window = sub_pln[(sub_pln['日付'] >= base_date) & (sub_pln['日付'] <= week_end)]
        daily_usage = float(usage_window['出'].mean()) if len(usage_window) > 0 else 0.0

        # 実棚卸数（最新棚卸日）
        inv_store = inv[
            (inv['店舗名'] == store)
            & (inv['原料JAN'].astype(str).str.strip() == material_jan)
        ]
        if len(inv_store) > 0:
            latest_date = inv_store['棚卸日_d'].max()
            qty_v = inv_store.loc[inv_store['棚卸日_d'] == latest_date, '棚卸数']
            try:
                latest_qty = float(pd.to_numeric(qty_v.iloc[0], errors='coerce'))
            except Exception:
                latest_qty = None
        else:
            latest_date, latest_qty = None, None

        # 余裕日数 & ステータス
        logical_today = forecasts[0]
        if daily_usage <= 0:
            margin_days = None
            status = '— 使用予定なし'
        elif logical_today is None:
            margin_days = None
            status = '— データなし'
        else:
            margin_days = logical_today / daily_usage
            if margin_days < 2:
                status = '🚨 危険'
            elif margin_days <= 4:
                status = '⚠️ 注意'
            else:
                status = '✅ 安全'

        row = {
            '店舗': store,
            '最新棚卸日': latest_date,
            '実棚卸数': latest_qty,
            '論理在庫': logical_today,
        }
        for d in range(horizon_days + 1):
            label = '当日' if d == 0 else f'+{d}日'
            row[label] = forecasts[d]
        row['1日使用量'] = daily_usage
        row['余裕日数'] = margin_days
        row['ステータス'] = status
        rows.append(row)

    return pd.DataFrame(rows)


# ==========================================================
# エリア在庫の移動候補サジェスト（2026/5/18 追加）
# ==========================================================
# 不足候補（余裕日数<2日）× 過剰候補（余裕日数>4日）の組合せから、
# 両店舗の余裕日数を目標値（既定5日）に近づける移動量を提示。
# 「— 使用予定なし」「⚠️ 注意」はサジェスト対象外。
TARGET_MARGIN_DAYS = 5


def calculate_move_suggestions(df_area, target_margin_days=TARGET_MARGIN_DAYS):
    """過剰候補 → 不足候補 の移動ペアと推奨移動量を計算。

    Returns:
        (suggestions_df, info_msg, unfulfilled_msg)
        - suggestions_df: 移動候補一覧 (空 DataFrame の場合あり)
        - info_msg: 不足候補なし／過剰候補なし時のメッセージ（あれば）
        - unfulfilled_msg: 移動後も不足が残る場合のメッセージ（あれば）
    """
    df_calc = df_area[df_area['余裕日数'].notna()].copy()

    shortage = df_calc[df_calc['余裕日数'] < 2].sort_values('余裕日数', ascending=True)
    surplus = df_calc[df_calc['余裕日数'] > 4].sort_values('余裕日数', ascending=False)

    if len(shortage) == 0:
        return pd.DataFrame(), '✅ 現在、エリア内に不足候補（🚨 危険）はありません。', None
    if len(surplus) == 0:
        return pd.DataFrame(), (
            '⚠️ 過剰候補（✅ 安全）がエリア内になく、エリア内移動では解決できません。'
            '**外部発注の検討が必要** です。'
        ), None

    # 過剰店の「余剰量」を初期化（目標日数を確保した上で余る分）
    surplus_list = []
    for _, r in surplus.iterrows():
        available = r['論理在庫'] - target_margin_days * r['1日使用量']
        if available > 0:
            surplus_list.append({
                'store': r['店舗'],
                'available': float(available),
                'logical': float(r['論理在庫']),
                'daily_usage': float(r['1日使用量']),
                'margin_curr': float(r['余裕日数']),
            })

    if not surplus_list:
        return pd.DataFrame(), (
            '⚠️ 過剰候補は存在しますが、目標日数'
            f'（{target_margin_days}日）を確保できるだけの余剰が見つかりません。'
        ), None

    suggestions = []
    unfulfilled = []

    for _, ns in shortage.iterrows():
        need = target_margin_days * ns['1日使用量'] - ns['論理在庫']
        if need <= 0:
            continue

        store_logical = float(ns['論理在庫'])
        store_usage = float(ns['1日使用量'])
        store_margin_curr = float(ns['余裕日数'])
        remaining = float(need)

        for sd in surplus_list:
            if remaining <= 0 or sd['available'] <= 0:
                continue
            move = min(remaining, sd['available'])

            new_logical_to = store_logical + move
            new_margin_to = new_logical_to / store_usage if store_usage > 0 else None
            new_logical_from = sd['logical'] - move
            new_margin_from = (new_logical_from / sd['daily_usage']
                               if sd['daily_usage'] > 0 else None)

            suggestions.append({
                '移動元': sd['store'],
                '元 余裕（前→後）': (
                    f"{sd['margin_curr']:.1f}日 → {new_margin_from:.1f}日"
                    if new_margin_from is not None else f"{sd['margin_curr']:.1f}日 → —"
                ),
                '推奨移動量': round(move, 1),
                '移動先': ns['店舗'],
                '先 余裕（前→後）': (
                    f"{store_margin_curr:.1f}日 → {new_margin_to:.1f}日"
                    if new_margin_to is not None else f"{store_margin_curr:.1f}日 → —"
                ),
            })

            # 状態更新
            sd['available'] -= move
            sd['logical'] = new_logical_from
            sd['margin_curr'] = new_margin_from if new_margin_from is not None else 0
            store_logical = new_logical_to
            store_margin_curr = new_margin_to if new_margin_to is not None else 0
            remaining -= move

        if remaining > 0:
            unfulfilled.append({
                'store': ns['店舗'],
                'remaining': round(remaining, 1),
                'final_margin': store_margin_curr,
            })

    unfulfilled_msg = None
    if unfulfilled:
        items = '、'.join(
            f"{u['store']}（不足残 {u['remaining']:.1f} / 余裕日数 {u['final_margin']:.1f}日）"
            for u in unfulfilled
        )
        unfulfilled_msg = (
            f"⚠️ 以下の店舗は提案ペア後も不足が残ります：{items}。"
            "**外部発注の検討が必要** です。"
        )

    return pd.DataFrame(suggestions), None, unfulfilled_msg


# ========== セッション初期化 ==========
if 'data_loaded' not in st.session_state:
    st.session_state.data_loaded = False
if 'store_params' not in st.session_state:
    st.session_state.store_params = {}
if 'adjustments' not in st.session_state:
    # adjustments[(店舗名, 原料JAN)] = {'補正値': float, '種別': str, 'メモ': str, '更新日': str}
    st.session_state.adjustments = load_adjustments_from_disk()
if 'data_version' not in st.session_state:
    # データ再取込のたびにインクリメント。キャッシュ無効化のキーとして使う。
    st.session_state.data_version = 0

# 起動時：ディスクから保存済みデータを自動読込
if not st.session_state.data_loaded:
    saved = load_data_from_disk()
    if saved:
        st.session_state.loaded = saved['loaded']
        st.session_state.last_update = saved['last_update']
        st.session_state.stores = saved['stores']
        st.session_state.data_loaded = True


# ========== サイドバー ==========
def process_uploaded_files(uploaded_files):
    """アップロードされたCSVを処理してsession_stateに保存"""
    loaded = {}
    for f in uploaded_files:
        df = load_csv_from_upload(f)
        kind = detect_file_kind(df)
        if kind:
            loaded[kind] = df
    
    required = ['recipe', 'material', 'plan', 'actual_prod', 'plan_del', 'actual_del', 'inventory']
    missing = [k for k in required if k not in loaded]
    if missing:
        st.error(f"以下のファイルが不足: {missing}")
        return False
    
    # 列名統一
    if '店舗' in loaded['inventory'].columns:
        loaded['inventory'] = loaded['inventory'].rename(columns={'店舗': '店舗名', 'CD': '店舗CD'})
    if '店舗' in loaded['plan'].columns:
        loaded['plan'] = loaded['plan'].rename(columns={'店舗': '店舗名', 'CD': '店舗CD'})
    if '店CD' in loaded['actual_prod'].columns:
        loaded['actual_prod'] = loaded['actual_prod'].rename(columns={'店CD': '店舗CD'})
    
    # 日付パース
    loaded['inventory']['棚卸日_d'] = loaded['inventory']['棚卸日'].apply(parse_jp_date)
    loaded['plan']['日付_d'] = loaded['plan']['日付'].apply(parse_jp_date)
    loaded['actual_prod']['日付_d'] = loaded['actual_prod']['日付'].apply(parse_jp_date)
    loaded['plan_del']['納品予定日_d'] = loaded['plan_del']['納品予定日'].apply(parse_jp_date)
    loaded['actual_del']['納品予定日_d'] = loaded['actual_del']['納品予定日'].apply(parse_jp_date)
    
    st.session_state.loaded = loaded
    st.session_state.data_loaded = True
    st.session_state.last_update = datetime.datetime.now()  # 更新時刻を記録
    st.session_state.stores = sorted(loaded['inventory']['店舗名'].dropna().unique().tolist())
    
    # ディスクに保存（他のブラウザからもアクセスできるように）
    save_data_to_disk(loaded, st.session_state.last_update, st.session_state.stores)
    
    return True


# ========== メインエリア ==========
# タイトル・サブタイトルは削除（コントローラーには不要）
