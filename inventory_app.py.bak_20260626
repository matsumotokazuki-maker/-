# ========== 定数 ==========
HOUZAI_KUBUN = {'包材(本体)', '包材（蓋）', '包材(内装)', 'シール'}

# データ保存先（アプリと同じフォルダの data サブディレクトリ）
DATA_DIR = Path(__file__).parent / 'data'
DATA_DIR.mkdir(exist_ok=True)
SAVE_PATH = DATA_DIR / 'session_data.pkl'
ADJUSTMENTS_PATH = DATA_DIR / 'adjustments.pkl'
WEBHOOK_CONFIG_PATH = DATA_DIR / 'webhook_config.json'
MATERIAL_GROUPS_PATH = DATA_DIR / 'material_groups.csv'
# 棚卸カウント確認画面：棚卸対象の店舗別 例外設定（2026-05-30 追加）
# 列: 店舗名, 原料JAN, 種別（'追加' / '除外'）。ベース層は inventory から動的取得のため不要。
TANAOROSHI_TARGET_OVERRIDE_PATH = DATA_DIR / 'tanaoroshi_target_store_override.csv'
# 仕込み指示画面：仕込み（解凍）対象の設定（2026-05-30 追加）
# ベース層（全店共通）＋店舗別上書きの2層。仕込み対象は 'TRUE'/'FALSE' 文字列。
SHIKOMI_TARGET_BASE_PATH = DATA_DIR / 'shikomi_target_base.csv'
SHIKOMI_TARGET_STORE_OVERRIDE_PATH = DATA_DIR / 'shikomi_target_store_override.csv'


def load_webhook_url():
    """Google Chat の Webhook URL を読み込む（未設定なら None）"""
    import json
    if WEBHOOK_CONFIG_PATH.exists():
        try:
            with open(WEBHOOK_CONFIG_PATH, 'r', encoding='utf-8') as f:
                cfg = json.load(f)
                return cfg.get('url')
        except Exception:
            return None
    return None


def save_webhook_url(url):
    """Google Chat の Webhook URL を保存"""
    import json
    try:
        with open(WEBHOOK_CONFIG_PATH, 'w', encoding='utf-8') as f:
            json.dump({'url': url}, f, ensure_ascii=False, indent=2)
        return True
    except Exception as e:
        st.error(f"Webhook設定保存エラー: {e}")
        return False


def send_to_google_chat(message, webhook_url):
    """Google Chat にテキストメッセージを送信。
    成功すれば True、失敗すれば エラーメッセージ文字列。
    """
    import requests
    try:
        response = requests.post(
            webhook_url,
            json={'text': message},
            timeout=10,
        )
        if response.status_code == 200:
            return True
        else:
            return f"送信失敗（HTTP {response.status_code}）：{response.text[:200]}"
    except requests.exceptions.Timeout:
        return "送信失敗：タイムアウト（10秒）"
    except requests.exceptions.ConnectionError:
        return "送信失敗：接続エラー（ネットワークを確認してください）"
    except Exception as e:
        return f"送信失敗：{e}"


def get_managed_jans_path(store=None):
    """管理対象原料の設定ファイルパス。
    store指定があれば店舗別ファイル、なければ共通ファイル。
    """
    import json
    if store:
        # ファイル名に使えない文字を除去
        safe = "".join(c for c in store if c.isalnum() or c in ('-', '_'))
        return DATA_DIR / f'managed_jans_{safe}.json'
    return DATA_DIR / 'managed_jans_common.json'


def load_managed_jans(store=None):
    """管理対象JANの設定を読み込む。
    優先順位：店舗別 > 共通 > なし（全表示）。
    
    Returns:
        dict: {'jans': [...], 'description': '...'} または None（設定なし）
    """
    import json
    if store:
        store_path = get_managed_jans_path(store)
        if store_path.exists():
            try:
                with open(store_path, 'r', encoding='utf-8') as f:
                    return json.load(f)
            except Exception:
                pass
    common_path = get_managed_jans_path(None)
    if common_path.exists():
        try:
            with open(common_path, 'r', encoding='utf-8') as f:
                return json.load(f)
        except Exception:
            pass
    return None


def save_managed_jans(jans, store=None, description=''):
    """管理対象JANを設定ファイルに保存"""
    import json
    path = get_managed_jans_path(store)
    data = {
        'jans': list(jans),
        'description': description,
        'store': store or '共通',
    }
    try:
        with open(path, 'w', encoding='utf-8') as f:
            json.dump(data, f, ensure_ascii=False, indent=2)
        return True
    except Exception as e:
        st.error(f"設定保存エラー: {e}")
        return False


def delete_managed_jans(store=None):
    """管理対象JANの設定ファイルを削除（=フィルタ解除）"""
    path = get_managed_jans_path(store)
    if path.exists():
        try:
            path.unlink()
            return True
        except Exception:
            pass
    return False


# ========== 店舗グルーピング設定（2026/5/18 追加） ==========
# CLAUDE.md §5.1.5「店舗スコープと将来拡張への備え」の具体化。
# 店舗をエリア・地域・カテゴリなどで業務単位にまとめ、エリア在庫タブ等で
# 横断ビューを実現するための設定を data/store_groups.json に保存する。
#
# データ構造：
#   {
#     "groups": [
#       {"name": "福岡市内エリア", "stores": ["宇美店", "筑紫野店", ...]},
#       ...
#     ],
#     "_updated_at": "ISO8601 timestamp"
#   }
def get_store_groups_path():
    return DATA_DIR / 'store_groups.json'


def load_store_groups():
    """店舗グルーピング設定を読込。ファイルなければ空構造を返す。"""
    import json
    path = get_store_groups_path()
    if not path.exists():
        return {'groups': []}
    try:
        with open(path, 'r', encoding='utf-8') as f:
            return json.load(f)
    except Exception:
        return {'groups': []}


def save_store_groups(data):
    """店舗グルーピング設定を保存。"""
    import json
    path = get_store_groups_path()
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    with open(path, 'w', encoding='utf-8') as f:
        json.dump(data, f, ensure_ascii=False, indent=2)


def get_store_to_group_map(groups_data=None):
    """{店舗名: グループ名} の dict を返す（未割り当て店舗は含まれない）。"""
    if groups_data is None:
        groups_data = load_store_groups()
    m = {}
    for g in groups_data.get('groups', []):
        gn = g.get('name', '')
        for s in g.get('stores', []):
            m[s] = gn
    return m


# ===========================================================
# 原料の関連グループ（material_groups.csv）
# ===========================================================
# CD違い同一原料の手動グループ定義を読み込むためのレイヤー。
# - 在庫データ本体には触らない（純粋な参照テーブル）
# - CSV 未配置でも空 DataFrame を返して動作継続（後方互換）
# - 列欠損などのフォーマット異常時はログのみ出力し例外を投げない
@st.cache_data(show_spinner=False)
def load_material_groups():
    """material_groups.csv を読み込んで DataFrame を返す。

    返り値の列：material_cd, group_id, group_name, note,
              registered_date, registered_by
    ファイル未存在・必須列欠損・読込例外のいずれも空 DataFrame を返す。
    """
    cols = ['material_cd', 'group_id', 'group_name', 'note',
            'registered_date', 'registered_by']
    if not MATERIAL_GROUPS_PATH.exists():
        return pd.DataFrame(columns=cols)
    try:
        df = pd.read_csv(MATERIAL_GROUPS_PATH, dtype=str, encoding='utf-8-sig')
        df.columns = df.columns.str.strip()
        required = ['material_cd', 'group_id']
        missing = [c for c in required if c not in df.columns]
        if missing:
            print(f"[WARN] material_groups.csv: 必須列が欠損 {missing}、空として扱います")
            return pd.DataFrame(columns=cols)
        for c in df.columns:
            if df[c].dtype == 'object':
                df[c] = df[c].fillna('').astype(str).str.strip()
        df = df[(df['material_cd'] != '') & (df['group_id'] != '')]
        for c in cols:
            if c not in df.columns:
                df[c] = ''
        return df[cols].reset_index(drop=True)
    except Exception as e:
        print(f"[WARN] material_groups.csv 読込失敗: {e}")
        return pd.DataFrame(columns=cols)


def get_related_material_cds(material_cd, groups_df=None):
    """指定の material_cd と同じグループに属する material_cd を全て返す（自分含む）。

    - グループ未登録の material_cd → 空リスト
    - グループ登録あり → 自分を含む全メンバー（重複なし、登録順）
    """
    if not material_cd:
        return []
    if groups_df is None:
        groups_df = load_material_groups()
    if len(groups_df) == 0:
        return []
    key = str(material_cd).strip()
    own_rows = groups_df[groups_df['material_cd'] == key]
    if len(own_rows) == 0:
        return []
    gid = own_rows['group_id'].iloc[0]
    members = groups_df[groups_df['group_id'] == gid]['material_cd'].tolist()
    seen = set()
    out = []
    for m in members:
        if m and m not in seen:
            seen.add(m)
            out.append(m)
    return out


def filter_by_managed_jans(df, managed_jans):
    """DataFrameを管理対象JANで絞り込む。
    managed_jans が None または空なら、絞り込まない（全表示）。
    """
    if not managed_jans or not managed_jans.get('jans'):
        return df
    if len(df) == 0:
        return df
    if '原料JAN' not in df.columns:
        return df
    return df[df['原料JAN'].isin(managed_jans['jans'])].copy()


# ===========================================================
# 棚卸カウント確認画面 ヘルパー（2026-05-30 追加）
# ===========================================================
# 「見込み在庫数」の予習画面用。棚卸対象は inventory（その店舗の登録原料）を
# ベースとし、店舗別の例外設定（追加/除外）で調整する。計算ロジックは新規作成せず
# calculate_flow の結果を再利用する（compute_expected_inventory を参照）。
def load_tanaoroshi_override():
    """棚卸対象の店舗別 例外設定 CSV を読込。
    列: 店舗名, 原料JAN, 種別（'追加' / '除外'）。未存在なら空 DataFrame。
    """
    cols = ['店舗名', '原料JAN', '種別']
    if not TANAOROSHI_TARGET_OVERRIDE_PATH.exists():
        return pd.DataFrame(columns=cols)
    try:
        df = pd.read_csv(TANAOROSHI_TARGET_OVERRIDE_PATH, dtype=str, encoding='utf-8-sig')
        df.columns = df.columns.str.strip()
        for c in cols:
            if c not in df.columns:
                df[c] = ''
        for c in cols:
            df[c] = df[c].fillna('').astype(str).str.strip()
        df = df[(df['店舗名'] != '') & (df['原料JAN'] != '')]
        return df[cols].reset_index(drop=True)
    except Exception as e:
        print(f"[WARN] tanaoroshi_target_store_override.csv 読込失敗: {e}")
        return pd.DataFrame(columns=cols)


def save_tanaoroshi_override(df):
    """棚卸対象の店舗別 例外設定 CSV を保存。"""
    cols = ['店舗名', '原料JAN', '種別']
    out = df.copy()
    for c in cols:
        if c not in out.columns:
            out[c] = ''
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    out[cols].to_csv(TANAOROSHI_TARGET_OVERRIDE_PATH, index=False, encoding='utf-8-sig')


def get_tanaoroshi_inventory_jans(store_name, loaded, opening_date=None):
    """その店舗の直近棚卸に登録されている原料JANセット（ベース層）を返す。"""
    inv = loaded.get('inventory')
    if inv is None or len(inv) == 0:
        return set()
    inv_s = inv[inv['店舗名'] == store_name]
    if len(inv_s) == 0:
        return set()
    if opening_date is None:
        if inv_s['棚卸日_d'].dropna().empty:
            return set()
        opening_date = inv_s['棚卸日_d'].dropna().max()
    inv_open = inv_s[inv_s['棚卸日_d'] == opening_date]
    jan_col = 'JAN' if 'JAN' in inv_open.columns else '原料JAN'
    return set(inv_open[jan_col].dropna().astype(str).unique())


def get_tanaoroshi_targets_for_store(store_name, loaded, opening_date=None, override_df=None):
    """棚卸カウント対象の最終 原料JAN セットを返す。
    = inventory のベース集合 ＋ 例外『追加』 − 例外『除外』。
    """
    base = get_tanaoroshi_inventory_jans(store_name, loaded, opening_date)
    if override_df is None:
        override_df = load_tanaoroshi_override()
    if len(override_df) > 0:
        ov = override_df[override_df['店舗名'] == store_name]
        add = set(ov[ov['種別'] == '追加']['原料JAN'].astype(str))
        rem = set(ov[ov['種別'] == '除外']['原料JAN'].astype(str))
        base = (base | add) - rem
    return base


def compute_expected_inventory(material_jan, flow_df, opening_dict,
                               period_start, period_end):
    """1原料の見込み在庫数を計算する。

    見込み在庫数 = 前回棚卸数 + 期間入数 − 期間出数

    計算ロジックは新規作成せず、calculate_flow が出力した日別の入/出（flow_df）を
    期間 (period_start, period_end] で集計するだけ。flow_df は opening_date を起点に
    残を積み上げているため、period_start == opening_date のとき period_end の「残」と
    一致する（＝既存の実績在庫推移の再利用）。

    Args:
        material_jan (str): 対象原料JAN。
        flow_df (pd.DataFrame): calculate_flow の出力（列 '原料JAN','日付','入','出','残'）。
        opening_dict (dict): {原料JAN: 前回棚卸数}。
        period_start (datetime.date): 期間起点（現状は全原料共通＝前回棚卸日）。
        period_end (datetime.date): 期間終点（＝棚卸予定日）。

    Returns:
        dict: {'前回棚卸数','期間入数','期間出数','見込み在庫数'}。

    Note:
        将来の部分棚卸対応では原料ごとに period_start が変わる。その場合は
        period_start 時点の実カウント値を base に据える拡張が必要（§6-1）。
    """
    prev = float(opening_dict.get(material_jan, 0.0))
    if flow_df is None or len(flow_df) == 0 or '原料JAN' not in flow_df.columns:
        return {'前回棚卸数': prev, '期間入数': 0.0, '期間出数': 0.0, '見込み在庫数': prev}
    sub = flow_df[flow_df['原料JAN'] == material_jan]
    sub = sub[(sub['日付'] > period_start) & (sub['日付'] <= period_end)]
    in_sum = float(sub['入'].sum())
    out_sum = float(sub['出'].sum())
    return {
        '前回棚卸数': prev,
        '期間入数': in_sum,
        '期間出数': out_sum,
        '見込み在庫数': prev + in_sum - out_sum,
    }


# ===========================================================
# 仕込み指示画面 ヘルパー（2026-05-30 追加）
# ===========================================================
# 翌日以降に解凍すべき寿司ネタの量（パック）を計算する。
# 在庫・納品予定は考慮しない（解凍は「使う前に冷凍から戻す」工程のため）。
# 仕込み対象は全店共通ベース＋店舗別上書きの2層で管理する。
def load_shikomi_target_base():
    """shikomi_target_base.csv を読込。ベース層（全店共通）の仕込み対象設定。
    列: 原料JAN, 原料名, 原料区分, 仕込み対象（'TRUE'/'FALSE' 文字列）
    """
    cols = ['原料JAN', '原料名', '原料区分', '仕込み対象']
    if not SHIKOMI_TARGET_BASE_PATH.exists():
        return pd.DataFrame(columns=cols)
    try:
        df = pd.read_csv(SHIKOMI_TARGET_BASE_PATH, dtype=str, encoding='utf-8-sig')
        df.columns = df.columns.str.strip()
        for c in cols:
            if c not in df.columns:
                df[c] = ''
        for c in df.columns:
            if df[c].dtype == 'object':
                df[c] = df[c].fillna('').astype(str).str.strip()
        return df[cols].reset_index(drop=True)
    except Exception as e:
        print(f"[WARN] shikomi_target_base.csv 読込失敗: {e}")
        return pd.DataFrame(columns=cols)


def save_shikomi_target_base(df):
    """ベース層を保存。"""
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    df.to_csv(SHIKOMI_TARGET_BASE_PATH, index=False, encoding='utf-8-sig')


def load_shikomi_target_store_override():
    """店舗別上書き設定を読込。
    列: 店舗名, 原料JAN, 仕込み対象（'TRUE'/'FALSE'）
    """
    cols = ['店舗名', '原料JAN', '仕込み対象']
    if not SHIKOMI_TARGET_STORE_OVERRIDE_PATH.exists():
        return pd.DataFrame(columns=cols)
    try:
        df = pd.read_csv(SHIKOMI_TARGET_STORE_OVERRIDE_PATH, dtype=str, encoding='utf-8-sig')
        df.columns = df.columns.str.strip()
        for c in cols:
            if c not in df.columns:
                df[c] = ''
        for c in df.columns:
            if df[c].dtype == 'object':
                df[c] = df[c].fillna('').astype(str).str.strip()
        return df[cols].reset_index(drop=True)
    except Exception as e:
        print(f"[WARN] shikomi_target_store_override.csv 読込失敗: {e}")
        return pd.DataFrame(columns=cols)


def save_shikomi_target_store_override(df):
    """店舗別上書きを保存。"""
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    df.to_csv(SHIKOMI_TARGET_STORE_OVERRIDE_PATH, index=False, encoding='utf-8-sig')


def get_shikomi_targets_for_store(store_name):
    """指定店舗の最終的な仕込み対象 原料JAN セットを返す。
    ベース層（対象=TRUE）に店舗別上書きをマージする。
    """
    base_df = load_shikomi_target_base()
    override_df = load_shikomi_target_store_override()

    base_target = set()
    if len(base_df) > 0:
        m = base_df['仕込み対象'].str.upper() == 'TRUE'
        base_target = set(base_df[m]['原料JAN'].dropna())

    if len(override_df) > 0:
        store_overrides = override_df[override_df['店舗名'] == store_name]
        for _, row in store_overrides.iterrows():
            jan = row['原料JAN']
            flag = str(row['仕込み対象']).upper() == 'TRUE'
            if flag:
                base_target.add(jan)
            else:
                base_target.discard(jan)

    return base_target


def compute_shikomi_for_store(store_name, loaded, target_dates):
    """指定店舗・指定日付群について、原料ごとの仕込み数量（パック）を計算。

    返り値: DataFrame（列 ['原料JAN','原料名','原料区分','入数', 日付1, 日付2, ...]）。
    各日付セルは「切り上げパック数」。全日0の原料は除外。

    計算ロジック:
      ある日の原料Xの必要量 = Σ(その日の各商品の計画数 × レシピでのX使用量)
      仕込み量(パック) = ceil(必要量 / 原料の入数)
    在庫・納品予定は考慮しない（解凍工程の性質上）。
    """
    import math

    plan = loaded.get('plan')
    recipe = loaded.get('recipe')
    material = loaded.get('material')

    if plan is None or recipe is None or material is None:
        return pd.DataFrame()
    if len(plan) == 0 or len(recipe) == 0:
        return pd.DataFrame()

    plan_s = plan[plan['店舗名'] == store_name].copy() if '店舗名' in plan.columns else plan.copy()
    if len(plan_s) == 0:
        return pd.DataFrame()

    target_jans = get_shikomi_targets_for_store(store_name)
    if not target_jans:
        return pd.DataFrame()

    # レシピを「商品JAN → [(原料JAN, 使用量), ...]」で持つ
    recipe_by_product = {}
    for _, r in recipe.iterrows():
        prod_jan = r['JAN']
        mat_jan = r['原料JAN']
        try:
            usage = float(r['使用量'])
        except (ValueError, TypeError):
            continue
        recipe_by_product.setdefault(prod_jan, []).append((mat_jan, usage))

    mat_idx = material.set_index('原料JAN')

    # need[mat_jan][date] = 必要量
    need = {jan: {d: 0.0 for d in target_dates} for jan in target_jans}
    for _, p in plan_s.iterrows():
        d = p.get('日付_d')
        if d not in target_dates:
            continue
        prod_jan = p.get('JAN')
        try:
            plan_qty = float(p['計画数'])
        except (ValueError, TypeError):
            continue
        if prod_jan not in recipe_by_product:
            continue
        for mat_jan, usage in recipe_by_product[prod_jan]:
            if mat_jan in target_jans:
                need[mat_jan][d] += plan_qty * usage

    rows = []
    for mat_jan, day_dict in need.items():
        if mat_jan not in mat_idx.index:
            continue
        mat_info = mat_idx.loc[mat_jan]
        if isinstance(mat_info, pd.DataFrame):  # 原料JAN重複時の保護
            mat_info = mat_info.iloc[0]
        try:
            pack_size = float(mat_info.get('入数', 1) or 1)
            if pack_size <= 0:
                pack_size = 1
        except (ValueError, TypeError):
            pack_size = 1

        row = {
            '原料JAN': mat_jan,
            '原料名': mat_info.get('原料名', ''),
            '原料区分': mat_info.get('原料区分', ''),
            '入数': int(pack_size) if pack_size == int(pack_size) else pack_size,
        }
        any_nonzero = False
        for d in target_dates:
            qty = day_dict.get(d, 0.0)
            packs = (qty / pack_size) if qty > 0 else 0  # [タスクH-2] ceil削除
            row[d] = packs
            if packs > 0:
                any_nonzero = True
        if any_nonzero:
            rows.append(row)

    if not rows:
        return pd.DataFrame()
    return pd.DataFrame(rows).sort_values(['原料区分', '原料名']).reset_index(drop=True)


def save_data_to_disk(loaded, last_update, stores):
    """取り込み済みデータをディスクに保存"""
    try:
        with open(SAVE_PATH, 'wb') as f:
            pickle.dump({
                'loaded': loaded,
                'last_update': last_update,
                'stores': stores,
            }, f)
        return True
    except Exception as e:
        st.error(f"データ保存エラー: {e}")
        return False


def load_data_from_disk():
    """ディスクから取り込み済みデータを読み込み"""
    if not SAVE_PATH.exists():
        return None
    try:
        with open(SAVE_PATH, 'rb') as f:
            return pickle.load(f)
    except Exception as e:
        st.warning(f"保存データの読込に失敗: {e}")
        return None


# ========== 取込パイプライン（正規ルートを管理画面から実行） ==========
# 設計（2026-06-06）：取り込みは convert_raw_to_app.py → update_data.py の正規ルートに一本化する。
# 旧「📥データ再取込」(process_uploaded_files=変換済み7ファイル全置換) はバッチの正規ルートと二重化し
# 実行バラつきの温床だった（CLAUDE.md §J）。ここでは核ロジック(update_data/convert_raw)は一切変更せず、
# subprocess で実証済みスクリプトを呼ぶだけ＝リスク最小で UI に集約する。
SCRIPT_DIR = Path(__file__).parent
RAW_EXPORT_DIR = SCRIPT_DIR / 'business_system_export'
INPUT_RAW_DIR = SCRIPT_DIR / 'input_raw'


def _list_csv_brief(folder, limit=40):
    """フォルダ直下のファイル名を簡易一覧（取込前の状況把握用）"""
    try:
        files = sorted([p.name for p in folder.glob('*') if p.is_file()])
    except Exception:
        return []
    return files[:limit]


def run_pipeline_script(script_name, timeout=600):
    """正規ルートのスクリプトを subprocess で実行し、結果を返す。
    update_data.py / convert_raw_to_app.py 末尾の input() は EOF/空行で抜ける（実証済み '' | python 方式）。
    戻り値: (ok: bool, log: str)
    """
    script_path = SCRIPT_DIR / script_name
    if not script_path.exists():
        return False, f"スクリプトが見つかりません: {script_path}"
    try:
        proc = subprocess.run(
            [sys.executable, str(script_path)],
            input='\n',                 # 末尾 input() を空入力で抜ける
            capture_output=True,
            text=True,
            encoding='utf-8',
            errors='replace',
            cwd=str(SCRIPT_DIR),        # 各スクリプトは cwd 相対で input_raw 等を読む
            timeout=timeout,
        )
        log = (proc.stdout or '') + (('\n[stderr]\n' + proc.stderr) if proc.stderr else '')
        return (proc.returncode == 0), log
    except subprocess.TimeoutExpired:
        return False, f"タイムアウト（{timeout}秒）：処理が長すぎます。"
    except Exception as e:
        return False, f"実行エラー: {e}"


# フルロード基本7ファイル（update_data.py の FULL_FILES と必ず一致させること）
_FULL_LOAD_FILES = [
    '原料データ.csv', 'レシピデータ.csv', '計画数データ.csv', '製造数データ.csv',
    '納品予定数.csv', '実納品数データ.csv', '棚卸データ.csv',
]


def auto_quarantine_fullload_for_diff():
    """差分日（input_raw に日付付きファイルがある日）に、過去フルロードの「日付なし基本7ファイル」が
    input_raw に残置していると、update_data.py が『フルロードと差分の混在』で停止する（取込が反映されない）。
    その混在条件＝update_data.py の detect_mode と同一（基本7ファイルが全部 かつ 日付付きファイルが1つ以上）
    のときだけ、日付なし基本7ファイルを input_raw\\_quarantine_fullload_YYYYMMDD_HHMMSS\\ へ自動退避する。

    - 取込は前フルロードで反映済みなので退避してもデータは失われない（可逆：戻せば再処理可）。
    - 月初フルロード（日付付きが無い日）や棚卸C方針（日付なし棚卸単独配置＝7ファイル揃わない）には作用しない。
    - update_data.py / convert_raw_to_app.py には一切手を入れない（CLAUDE.md §N の鉄則）。
    戻り値: (moved: list[str], quarantine_dir_name: str|None)
    """
    try:
        files = list(INPUT_RAW_DIR.glob('*.csv'))
    except Exception:
        return [], None
    names = {p.name for p in files}
    has_full = all(n in names for n in _FULL_LOAD_FILES)
    # 日付付き判定：先頭8桁が数字（YYYYMMDD<種別>.csv）＝update_data の差分判定と整合
    has_diff = any(p.name[:8].isdigit() and len(p.name) > 12 for p in files)
    if not (has_full and has_diff):
        return [], None
    stamp = datetime.datetime.now().strftime('%Y%m%d_%H%M%S')
    qdir = INPUT_RAW_DIR / f'_quarantine_fullload_{stamp}'
    try:
        qdir.mkdir(parents=True, exist_ok=True)
        moved = []
        for n in _FULL_LOAD_FILES:
            src = INPUT_RAW_DIR / n
            if src.exists():
                src.rename(qdir / n)
                moved.append(n)
        return moved, qdir.name
    except Exception:
        return [], None


def reload_pkl_into_session():
    """update_data.py が更新した session_data.pkl を読み直して session_state に反映。
    戻り値: (ok: bool, msg: str)
    """
    saved = load_data_from_disk()
    if not saved:
        return False, "pkl の読込に失敗しました（session_data.pkl が見つからない／壊れている）。"
    st.session_state.loaded = saved['loaded']
    st.session_state.last_update = saved.get('last_update')
    st.session_state.stores = saved['stores']
    st.session_state.data_loaded = True
    # 計算キャッシュ無効化（古いデータでの計算結果を使わせない）
    st.session_state.data_version = st.session_state.get('data_version', 0) + 1
    return True, f"{len(saved['stores'])}店舗を再読込しました。"


