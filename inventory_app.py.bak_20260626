- **目的**：📦 エリア在庫タブで、同じエリア内の店舗の在庫を横断的に確認・移動計画を立てる
- **制約**：1店舗は1グループにのみ所属（複数所属は仕様上不可）
- **保存先**：`data/store_groups.json`
- **設計方針**：CLAUDE.md §5.1.5「店舗スコープと将来拡張への備え」の具体化
- **編集**：このタブで随時編集できます。設定変更は即座に他タブに反映されます
""")


# ==========================================================
# 📡 データモニタリング（異常検知）ヘルパー — 2026-06-08 追加（Step1）
# 全店横断で A:在庫切れ緊急 / B:取込健全性 / C:二重計上 / D:マスタ未登録 を監視。
# 原則4：検知と"振り先"のみ（対策は出さない）。利用者＝本部・設計視点。
# A は calculate_flow_cached を全店×2回呼ぶ重い処理のためボタンで実行。B/C/Dは pkl直読みで軽量。
# ==========================================================
def _dm_store_margins(store, today):
    """1店の計画/実績の余裕日数を原料単位で返す（⓪余裕日数のロジックを計画/実績2軸へ拡張）。"""
    loaded = st.session_state.loaded
    adj = get_adjustments_for_store(store)
    try:
        act_max = loaded['actual_prod']['日付_d'].dropna().max()
    except Exception:
        act_max = None
    df_pln = calculate_flow_cached(store, None, 3, 0.7, 0.9, adj)
    df_act = calculate_flow_cached(store, act_max, 3, 0.7, 0.9, adj)
    if df_pln is None or df_act is None or df_pln.empty or df_act.empty:
        return pd.DataFrame()
    if '原料JAN' not in df_pln.columns or '日付' not in df_pln.columns:
        return pd.DataFrame()
    week_end = today + datetime.timedelta(days=7)
    pweek = df_pln[(df_pln['日付'] >= today) & (df_pln['日付'] <= week_end)]
    usage = pweek.groupby('原料JAN')['出'].mean()

    def _cur(df):
        if today in set(df['日付'].values):
            c = df[df['日付'] == today]
        else:
            past = df[df['日付'] <= today]['日付']
            ref = past.max() if len(past) else df['日付'].min()
            c = df[df['日付'] == ref]
        return c.groupby('原料JAN')['残'].last()

    meta = df_pln.drop_duplicates('原料JAN').set_index('原料JAN')[['原料名', '原料区分']]
    out = meta.copy()
    out['1日使用量'] = usage
    out['現在残_計画'] = _cur(df_pln)
    out['現在残_実績'] = _cur(df_act)
    out = out[out['1日使用量'] > 0].copy()
    if out.empty:
        return pd.DataFrame()
    out['計画余裕'] = out['現在残_計画'] / out['1日使用量']
    out['実績余裕'] = out['現在残_実績'] / out['1日使用量']
    out['店舗'] = store
    out = out.reset_index()  # 原料JAN を列へ
    # 棚卸opening（その店の最新棚卸日に在庫計上があるか）。データ未整備の切り分け用：
    # opening無しで残が構造的にマイナス＝在庫として管理されていない（振替/IN加工等）＝真の在庫切れでない。
    opened = set()
    try:
        inv = loaded.get('inventory')
        if inv is not None and '店舗名' in inv.columns:
            inv_s = inv[inv['店舗名'] == store]
            if not inv_s.empty and '棚卸日_d' in inv_s.columns:
                od = inv_s['棚卸日_d'].dropna().max()
                jcol = 'JAN' if 'JAN' in inv_s.columns else '原料JAN'
                opened = set(inv_s[inv_s['棚卸日_d'] == od][jcol].astype(str))
    except Exception:
        opened = set()
    out['棚卸opening'] = out['原料JAN'].astype(str).isin(opened)
    # 管理対象原料に絞る（⓪余裕日数・既存タブと同一）。
    out = filter_by_managed_jans(out, load_managed_jans(store))
    return out


def _dm_scan_stockout(today):
    """全運用店舗の在庫切れ緊急（計画×実績 余裕日数）を集約。"""
    stores = st.session_state.get('stores', []) or []
    frames = []
    for s in stores:
        try:
            m = _dm_store_margins(s, today)
            if m is not None and not m.empty:
                frames.append(m)
        except Exception:
            continue
    if not frames:
        return pd.DataFrame()
    return pd.concat(frames, ignore_index=True)


def _dm_data_quality(today):
    """B:鮮度／C:全列一致重複／D:仮JAN の軽量チェック（pkl直読み）。"""
    loaded = st.session_state.loaded
    res = {'fresh': [], 'dup': [], 'kari': 0, 'kari_total': 0, 'kari_rows': pd.DataFrame()}
    for k in ['actual_prod', 'actual_del']:
        df = loaded.get(k)
        dcol = '日付_d' if k == 'actual_prod' else '納品予定日_d'
        if df is None or dcol not in df.columns:
            continue
        mx = pd.to_datetime(df[dcol], errors='coerce').max()
        if pd.notna(mx):
            res['fresh'].append((k, mx.date(), (today - mx.date()).days))
    for k in ['plan', 'plan_del', 'inventory']:
        df = loaded.get(k)
        if df is None:
            continue
        n = int(df.duplicated().sum())
        if n:
            res['dup'].append((k, n))
    ap = loaded.get('actual_prod')
    if ap is not None and 'JAN' in ap.columns:
        mask = ap['JAN'].astype(str).str.startswith('9992')
        res['kari_total'] = int(mask.sum())
        if res['kari_total']:
            uniq = ap[mask].drop_duplicates(['JAN'])
            res['kari'] = int(len(uniq))
            cols = [c for c in ['店舗名', 'JAN', '商品名', '製造数', '日付'] if c in ap.columns]
            res['kari_rows'] = uniq[cols].head(50)
    return res


# ========== タブ10：管理者設定（全体に関わる管理機能） ==========
# データ再取込など、店舗をまたいで影響する機能を集約
with tab10:
    st.subheader("🛠️ 管理者設定")
    st.caption("全店舗に影響する管理操作です。慎重に行ってください。")
    
    st.markdown("""
    <div style='
        background: #fff3e0;
        border-left: 4px solid #ef6c00;
        padding: 10px 14px;
        border-radius: 4px;
        margin: 8px 0 16px 0;
