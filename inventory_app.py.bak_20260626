def get_adjustments_for_store(store_name):
    """指定店舗の補正値を {原料JAN: 補正値} 辞書で返す"""
    result = {}
    for (s, jan), data in st.session_state.adjustments.items():
        if s == store_name and data.get('補正値', 0) != 0:
            result[jan] = data['補正値']
    return result


