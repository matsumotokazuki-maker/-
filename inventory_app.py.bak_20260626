])


def render_html_table(df, scope, pin_cols=None, col_formats=None, col_labels=None,
                      col_align=None, pin_widths=None, cell_class_func=None,
                      max_height=600, font_rem=1.0):
    """汎用 sticky HTMLテーブル（タスクG-2 2026/6/3）。

    在庫推移表(.flowtbl)の sticky パターンを流用し、表示専用の表を
    「文字大・高コントラスト・行/列見出し固定」で描画する。st.dataframe の
    インタラクティブ機能（ソート・列幅変更・セル選択）は持たない（現場未使用前提）。
    既存ロジックには触れず、表示のみを置き換えるための純粋なレンダラ。

    df          : 表示用 DataFrame（列順は表示順そのまま）。
    scope       : CSSクラススコープ。タブ/表間で干渉しないようユニークにする。
    pin_cols    : 左固定する列名リスト（左→右）。None なら先頭1列。
    col_formats : {列名: '%.1f' 等}。数値のみ適用、NaN/None は空欄。
    col_labels  : {列名: 表示見出し}。
    col_align   : {列名: 'left'|'center'|'right'}。pin列は常に left、未指定の非pin列は right。
    pin_widths  : {列名: px}。固定列の幅。未指定はデフォルト（先頭220, 以降110）。
    cell_class_func: (列名, 生値)->追加CSSクラス（'neg'/'pos'/'ctr' 等。色付け用）。
    max_height  : 縦スクロール上限px。font_rem: セル文字サイズ(rem)。
    """
    if df is None or len(df) == 0:
        st.warning("データがありません")
        return
    cols = list(df.columns)
    pin_cols = [c for c in (pin_cols or ([cols[0]] if cols else [])) if c in cols]
    col_formats = col_formats or {}
    col_labels = col_labels or {}
    col_align = col_align or {}
    pin_widths = pin_widths or {}

    def esc(v):
        return str(v).replace('&', '&amp;').replace('<', '&lt;').replace('>', '&gt;').replace('"', '&quot;')

    pin_index = {c: i for i, c in enumerate(pin_cols)}
    # 固定列の left オフセット計算
    widths = [int(pin_widths.get(c, 220 if i == 0 else 110)) for i, c in enumerate(pin_cols)]
    lefts, acc = [], 0
    for w in widths:
        lefts.append(acc); acc += w

    css = ['<style>']
    css.append(f'.{scope}-wrap {{ overflow:auto; max-height:{max_height}px; border:1px solid #8a94a6; border-radius:4px; }}')
    css.append(f'.{scope} {{ border-collapse:collapse; font-size:{font_rem}rem; white-space:nowrap; width:100%; }}')
    css.append(f'.{scope} th {{ padding:8px 12px; border:1px solid #8a94a6; text-align:center; background:#cdd6e8; color:#16243b; font-weight:700; }}')
    css.append(f'.{scope} thead tr {{ position:sticky; top:0; z-index:3; }}')
    css.append(f'.{scope} td {{ padding:7px 12px; border:1px solid #aab2c0; color:#111; text-align:right; }}')
    css.append(f'.{scope} td.lbl {{ text-align:left; overflow:hidden; text-overflow:ellipsis; }}')
    css.append(f'.{scope} td.ctr {{ text-align:center; }}')
    css.append(f'.{scope} tbody tr:nth-child(odd) td {{ background:#ffffff; }}')
    css.append(f'.{scope} tbody tr:nth-child(even) td {{ background:#eef2f9; }}')
    for i, (w, l) in enumerate(zip(widths, lefts)):
        css.append(f'.{scope} .pc{i} {{ position:sticky; left:{l}px; min-width:{w}px; max-width:{w}px; z-index:1; }}')
        css.append(f'.{scope} thead .pc{i} {{ z-index:4; left:{l}px; }}')
    # 固定列セルの背景を不透明に（下の内容が透けないように）。even/odd を上書き。
    css.append(f'.{scope} tbody tr:nth-child(odd) td.pcfix {{ background:#ffffff; }}')
    css.append(f'.{scope} tbody tr:nth-child(even) td.pcfix {{ background:#e3e9f4; }}')
    # 色付けクラス（コントラスト強化）
    css.append(f'.{scope} td.neg {{ color:#b71c1c; font-weight:700; }}')
    css.append(f'.{scope} td.pos {{ color:#1b5e20; font-weight:700; }}')
    css.append('</style>')

    out = [''.join(css), f'<div class="{scope}-wrap"><table class="{scope}">', '<thead><tr>']
    for c in cols:
        cls = f' class="pc{pin_index[c]} pcfix"' if c in pin_index else ''
        out.append(f'<th{cls}>{esc(col_labels.get(c, c))}</th>')
    out.append('</tr></thead><tbody>')
    for _, row in df.iterrows():
        out.append('<tr>')
        for c in cols:
            v = row[c]
            if pd.isna(v):
                disp = ''
            elif c in col_formats and isinstance(v, (int, float, np.integer, np.floating)):
                disp = col_formats[c] % float(v)
            else:
                disp = str(v)
            classes = []
            if c in pin_index:
                classes.append(f'pc{pin_index[c]} pcfix lbl')
            else:
                a = col_align.get(c, 'right')
                if a == 'left':
                    classes.append('lbl')
                elif a == 'center':
                    classes.append('ctr')
            if cell_class_func:
                extra = cell_class_func(c, v)
                if extra:
                    classes.append(extra)
            cls = f' class="{" ".join(classes)}"' if classes else ''
            title = f' title="{esc(disp)}"' if c in pin_index else ''
            out.append(f'<td{cls}{title}>{esc(disp)}</td>')
        out.append('</tr>')
    out.append('</tbody></table></div>')
    st.markdown(''.join(out), unsafe_allow_html=True)


def render_inventory_table(df, mode_label):
    if len(df) == 0:
        st.warning("データがありません")
        return
    
    # ---- サマリーから引き継いだ原料フィルタ（focus_jans）の処理 ----
    # 一時ファイル経由でタブ間共有（session_state ではタブ間で消えるため）
    focus_jans_file = DATA_DIR / 'focus_jans.txt'
    focus_jans = []
    try:
        if focus_jans_file.exists():
            content = focus_jans_file.read_text(encoding='utf-8').strip()
            if content:
                focus_jans = [j for j in content.split(',') if j]
    except Exception as e:
        st.error(f"focus_jans読込エラー: {e}")
    apply_focus = bool(focus_jans)
    
    if apply_focus:
        # バナー表示：選択中の原料一覧と「クリア」ボタン
        # 原料名を取得
        focus_names = df[df['原料JAN'].isin(focus_jans)][['原料JAN', '原料名']].drop_duplicates()
        n_focus = len(focus_names)
        n_missing = len(focus_jans) - n_focus  # この店舗のデータに存在しない原料
        
        banner_col1, banner_col2 = st.columns([5, 1])
        with banner_col1:
            names_str = '、'.join(focus_names['原料名'].head(5).tolist())
            if n_focus > 5:
                names_str += f' 他{n_focus - 5}件'
            msg = f"🔍 サマリーで選択された原料のみ表示中（{n_focus}件）：{names_str}"
            if n_missing > 0:
                msg += f"　※ {n_missing}件はこの店舗のデータにありません"
            st.info(msg)
        with banner_col2:
            if st.button("クリア", key=f"clear_focus_{mode_label}", use_container_width=True):
                # ファイルベースのfocus_jansを削除
                try:
                    f = DATA_DIR / 'focus_jans.txt'
                    if f.exists():
                        f.unlink()
                except Exception:
                    pass
                st.rerun()
    
    col1, col2 = st.columns([3, 1])
    with col1:
        # 2026/5/19：selectbox → radio に変更（タブレットでソフトキーボードを出さないため）。
        # 「区分内の全原料を俯瞰表示」という業務的価値は変えず、絞り込みUIだけ変更。
        kbn_options = ['全て'] + sorted(df['原料区分'].dropna().unique().tolist())
        kbn = st.radio(
            "原料区分",
            kbn_options,
            horizontal=True,
            key=f"kbn_{mode_label}",
            help="区分を選ぶと、その区分内の全原料を一覧表示",
        )
    with col2:
        only_minus = st.checkbox("差マイナスのみ", value=False, key=f"minus_{mode_label}")
    
    df_view = df.copy()
    
    # focus_jans が有効ならまずそれで絞り込む
    if apply_focus:
        df_view = df_view[df_view['原料JAN'].isin(focus_jans)]
    
    if kbn != '全て':
        df_view = df_view[df_view['原料区分'] == kbn]
    
    if only_minus:
        bad_jans = df_view[df_view['差'] < 0]['原料JAN'].unique()
        df_view = df_view[df_view['原料JAN'].isin(bad_jans)]
    
    if len(df_view) == 0:
        st.warning("該当原料がありません")
        return
    
    items = ['入', '出', '残', '安全在庫', '差']
    pivot_dfs = []
    for item in items:
        p = df_view.pivot_table(
            index=['原料JAN', '原料名', '原料区分', '対象区分'],
            columns='日付', values=item, aggfunc='first'
        )
        p['項目'] = item
        p = p.reset_index().set_index(['原料JAN', '原料名', '原料区分', '対象区分', '項目'])
        pivot_dfs.append(p)
    
    combined = pd.concat(pivot_dfs).reset_index()
    
    item_order = {'入': 1, '出': 2, '残': 3, '安全在庫': 4, '差': 5}
    combined['_o'] = combined['項目'].map(item_order)
    combined = combined.sort_values(['原料JAN', '_o']).drop('_o', axis=1)
    
    weekday_jp = {'Mon':'月','Tue':'火','Wed':'水','Thu':'木','Fri':'金','Sat':'土','Sun':'日'}
    date_cols = [c for c in combined.columns if isinstance(c, datetime.date)]
    rename = {c: c.strftime(f'%m/%d({weekday_jp[c.strftime("%a")]})') for c in date_cols}
    combined = combined.rename(columns=rename)
    new_dates = list(rename.values())
    
    for c in new_dates:
        combined[c] = pd.to_numeric(combined[c], errors='coerce').round(1)
    
    safety_lookup = {}
    for _, r in combined[combined['項目']=='安全在庫'].iterrows():
        safety_lookup[r['原料JAN']] = {dc: r[dc] for dc in new_dates}
        
    # ----- CSSを1回だけ定義し、各セルはclass参照のみ -----
    # これによりHTML総量を大幅削減（インラインスタイル数千個 → class名数千個）
    # スコープを区別するため mode_label をクラス名に含める
    scope = f"flowtbl-{mode_label}"
    css = f"""
    <style>
    .{scope}-wrap {{ overflow-x:auto; max-height:600px; overflow-y:auto;
                     border:1px solid #ddd; border-radius:4px; }}
    .{scope} {{ border-collapse:collapse; font-size:0.95rem; white-space:nowrap; width:100%; }}
    .{scope} th {{ padding:7px 9px; border:1px solid #8a94a6; text-align:center; background:#cdd6e8; color:#16243b; font-weight:700; }}
    .{scope} thead tr {{ position:sticky; top:0; z-index:3; }}
    .{scope} td {{ padding:5px 9px; border:1px solid #aab2c0; color:#111; text-align:right; }}
    .{scope} td.lbl {{ text-align:left; overflow:hidden; text-overflow:ellipsis; }}
    /* 左側固定3列：sticky位置 + 幅 */
    .{scope} .sc0 {{ position:sticky; left:0px;   min-width:240px; max-width:240px; z-index:1; }}
    .{scope} .sc1 {{ position:sticky; left:240px; min-width:70px;  max-width:70px;  z-index:1; }}
    .{scope} .sc2 {{ position:sticky; left:310px; min-width:70px;  max-width:70px;  z-index:1; }}
    .{scope} thead .sc0 {{ z-index:4; min-width:240px; max-width:240px; left:0px; }}
    .{scope} thead .sc1 {{ z-index:4; min-width:70px;  max-width:70px;  left:240px; }}
    .{scope} thead .sc2 {{ z-index:4; min-width:70px;  max-width:70px;  left:310px; }}
    .{scope} th.dt {{ min-width:75px; }}
    /* 行ごとの背景色（項目別） */
    .{scope} tr.r-zan  td {{ background:#e3f2fd; font-weight:bold; }}
    .{scope} tr.r-sa   td {{ background:#fafafa; }}
    .{scope} tr.r-base td {{ background:white; }}
    /* 残セルの状態色（行背景を上書き）。タスクG-2でコントラスト強化 */
    .{scope} td.bg-shortage {{ background:#ff9f9f !important; color:#7f0000; font-weight:bold; }}
    .{scope} td.bg-excess   {{ background:#ffe066 !important; color:#5f4b00; }}
    .{scope} td.bg-ok       {{ background:#9fd6a3 !important; color:#10401a; }}
    /* 差マイナス */
    .{scope} td.tx-minus {{ color:#c62828; font-weight:bold; }}
    </style>
    """
        
    html = [css]
    html.append(f'<div class="{scope}-wrap"><table class="{scope}">')
        
    # ----- ヘッダ -----
    sticky_cols = ['原料名', '対象区分', '項目']
    html.append('<thead><tr>')
    for i, col in enumerate(sticky_cols):
        html.append(f'<th class="sc{i}">{col}</th>')
    for col in new_dates:
        html.append(f'<th class="dt">{col}</th>')
    html.append('</tr></thead><tbody>')
        
    # ----- ボディ -----
    item_to_rclass = {'残': 'r-zan', '差': 'r-sa'}  # それ以外は r-base
    for _, row in combined.iterrows():
        jan = row['原料JAN']
        item = row['項目']
        row_class = item_to_rclass.get(item, 'r-base')
            
        html.append(f'<tr class="{row_class}">')
        # 左側3列（原料名・対象区分・項目）
        label_vals = [str(row['原料名']), str(row['対象区分']), item]
        for i, val in enumerate(label_vals):
            html.append(f'<td class="sc{i} lbl" title="{val}">{val}</td>')
            
        # 日付セル
        for dc in new_dates:
            val = row[dc]
            cell_class = ''
                
            if isinstance(val, (int, float)) and not pd.isna(val):
                if item == '残':
                    sv = safety_lookup.get(jan, {}).get(dc)
                    if isinstance(sv, (int, float)) and not pd.isna(sv):
                        if val < sv:
                            cell_class = 'bg-shortage'
                        elif val > sv * 2 and sv > 0:
                            cell_class = 'bg-excess'
                        else:
                            cell_class = 'bg-ok'
                elif item == '差':
                    if val < 0:
                        cell_class = 'tx-minus'
                disp = f'{val:.1f}'
            else:
                disp = '-'
                
            if cell_class:
                html.append(f'<td class="{cell_class}">{disp}</td>')
            else:
                html.append(f'<td>{disp}</td>')
        html.append('</tr>')
    html.append('</tbody></table></div>')
        
    st.markdown(''.join(html), unsafe_allow_html=True)
    st.caption(
        f"表示中：{combined['原料JAN'].nunique()} 原料 ｜ "
        f"**残行の色**：🟢適正 🟥不足 🟨過剰 ｜ 差<0は赤字"
    )


with tab2:
    st.subheader(f"📈 計画上の在庫推移（{selected_store}）")
    st.caption(f"期首（{opening_date}）の棚卸数を起点に、納品予定と計画数で全期間を計算")
    render_inventory_table(df_plan, '計画')


with tab3:
    st.subheader(f"📉 実績上の在庫推移（{selected_store}）")
    st.caption(
        f"期首（{opening_date}）から指定日（{params['target_date']}）まで実績で計算 → "
        f"以降は計画で再計算"
    )
    render_inventory_table(df_actual, '実績')


# ========== タブ：仕込み指示（2026-05-30 追加） ==========
# 現場が毎朝開く最左タブ。今日〜1週間先の寿司ネタ解凍数量（パック）を一覧表示。
# 計算：その日の計画数 × レシピ展開 → 必要量 ÷ 入数 → 切り上げ → パック数。
# 在庫・納品予定は考慮しない（解凍は使用前提の工程のため）。
with tab_shikomi:
    st.subheader("🍣 仕込み指示")

    today = datetime.date.today()
    target_dates = [today + datetime.timedelta(days=i) for i in range(7)]  # 今日〜+6日
    target_jans_shikomi = get_shikomi_targets_for_store(selected_store)

    if not target_jans_shikomi:
        st.info(
            "**仕込み対象がまだ設定されていません。**\n\n"
            "下の「⚙️ 仕込み対象の設定」（自動で開いています）で、"
            "仕込み（解凍）したい**原料区分**（マグロ・サーモン等）を選んで保存してください。"
        )
    else:
        st.caption(
            f"店舗: {selected_store}　|　"
            f"表示期間: {target_dates[0].strftime('%Y/%m/%d')} 〜 "
            f"{target_dates[-1].strftime('%m/%d')}（7日分）　|　"
            f"対象原料: {len(target_jans_shikomi)}件"
        )

        with st.spinner("仕込み量を計算中..."):
            df_shikomi = compute_shikomi_for_store(selected_store, loaded, target_dates)

        if len(df_shikomi) == 0:
            st.info(
                "対象期間に仕込みが必要な原料がありません。\n"
                "（翌日以降の計画データが無い、もしくは対象原料が計画に含まれていない可能性があります）"
            )
        else:
            weekday_jp = ['月', '火', '水', '木', '金', '土', '日']
            date_label_map = {
                d: f"{d.month}/{d.day}({weekday_jp[d.weekday()]})"
                for d in target_dates
            }
            df_display = df_shikomi.rename(columns=date_label_map)
            for _gi, (kbn, grp) in enumerate(df_display.groupby('原料区分', sort=False)):
                st.markdown(f"#### 🔸 {kbn}")
                display_cols = ['原料名', '入数'] + [date_label_map[d] for d in target_dates]
                grp_show = grp[display_cols].copy()
                for c in [date_label_map[d] for d in target_dates]:
                    grp_show[c] = grp_show[c].apply(lambda x: '' if x == 0 else f"{float(x):.1f}")  # [タスクH]
                # タスクG-2：sticky HTML表（原料名固定・文字大）。日付セルは右寄せ既定。
                render_html_table(
                    grp_show, scope=f"htbl-shikomi-{_gi}",
                    pin_cols=['原料名'], pin_widths={'原料名': 240},
                    max_height=520,
                )
            st.caption(
                "※ 数値はパック単位（切り上げ）。空欄は0パック。"
                "計画が変更されると次回の取込で反映されます。"
            )

    # ---- 仕込み対象の設定（区分でまとめて選ぶ方式：2026-05-30 UI改善） ----
    # 「対象にする原料区分を選ぶ→保存」を主操作にし、初見でも迷わない導線にする。
    # 個別の例外・店舗別上書きは副次的な折りたたみに分離。
    st.markdown("---")
    material_df_sk = loaded.get('material')
    _setup_open = not target_jans_shikomi  # 未設定なら最初から開く
    with st.expander("⚙️ 仕込み対象の設定", expanded=_setup_open):
        if material_df_sk is None or len(material_df_sk) == 0:
            st.info("原料マスタが読込まれていません。")
        else:
            name_map_sk = dict(zip(material_df_sk['原料JAN'].astype(str), material_df_sk['原料名']))

            def _sk_label(j):
                nm = name_map_sk.get(j, '')
                return f"{nm}（{j}）" if nm else j

            # 現在の対象（ベース層の TRUE）
            base_df = load_shikomi_target_base()
            cur_targets = set()
            if len(base_df) > 0:
                cur_targets = set(base_df[base_df['仕込み対象'].str.upper() == 'TRUE']['原料JAN'])

            # 区分一覧（業務的並び順：寿司ネタが先頭）
            ordered_kbn = get_sorted_material_categories(material_df_sk, exclude_target_gai=False)
            cur_on_kbn = sorted(
                set(material_df_sk[material_df_sk['原料JAN'].astype(str).isin(cur_targets)]['原料区分'].dropna()),
                key=lambda k: ordered_kbn.index(k) if k in ordered_kbn else 999,
            )

            st.markdown("##### ① 仕込み対象にする原料区分を選ぶ")
            sel_kbn = st.multiselect(
                "原料区分（複数選択可）",
                ordered_kbn,
                default=cur_on_kbn,
                key="sk_kbn_select",
                help="選んだ区分の原料すべてが仕込み（解凍）対象になります。寿司ネタ区分が上に並びます。",
            )
            st.markdown("##### ② 保存する")
            if st.button("💾 選んだ区分を仕込み対象にする", key="sk_save_kbn", type="primary"):
                out = material_df_sk[['原料JAN', '原料名', '原料区分']].copy()
                out['仕込み対象'] = out['原料区分'].isin(sel_kbn).map({True: 'TRUE', False: 'FALSE'})
                save_shikomi_target_base(out)
                st.success(f"{int((out['仕込み対象'] == 'TRUE').sum())}原料を仕込み対象にしました。")
                st.rerun()

            # 現在の対象サマリー
            if cur_targets:
                bd = (material_df_sk[material_df_sk['原料JAN'].astype(str).isin(cur_targets)]
                      .groupby('原料区分').size())
                bd = bd.reindex([k for k in ordered_kbn if k in bd.index])
                parts = '・'.join(f"{k}{int(v)}" for k, v in bd.items())
                st.info(f"✅ 現在の仕込み対象：**{len(cur_targets)}原料**（{parts}）")
            else:
                st.warning("まだ仕込み対象がありません。区分を選んで「💾 選んだ区分を仕込み対象にする」を押してください。")

            # ② 個別の微調整（任意）
            with st.expander("▶ 詳細調整：個別に追加・除外（任意）", expanded=False):
                st.caption("区分での一括設定のあと、例外的に個別の原料を足したり外したりできます。")
                off_jans = sorted(set(material_df_sk['原料JAN'].astype(str)) - cur_targets - {''})
                incl = st.multiselect(
                    "➕ 個別に追加する原料", off_jans, format_func=_sk_label, key="sk_incl",
                )
                excl = st.multiselect(
                    "➖ 個別に除外する原料", sorted(cur_targets), format_func=_sk_label, key="sk_excl",
                )
                if st.button("💾 個別調整を保存", key="sk_save_indiv"):
                    new_t = (cur_targets - set(excl)) | set(incl)
                    out = material_df_sk[['原料JAN', '原料名', '原料区分']].copy()
                    out['仕込み対象'] = out['原料JAN'].astype(str).isin(new_t).map({True: 'TRUE', False: 'FALSE'})
                    save_shikomi_target_base(out)
                    st.success("個別調整を保存しました。")
                    st.rerun()

            # ③ 店舗別の上書き（任意）
            with st.expander("🏪 店舗別の上書き（この店舗だけ変えたいとき・任意）", expanded=False):
                st.caption(f"店舗: **{selected_store}** だけベースと違う設定にしたいときに使います。")
                override_df = load_shikomi_target_store_override()
                store_override = override_df[override_df['店舗名'] == selected_store].copy()
                if len(store_override) == 0:
                    st.info("上書きはまだありません。ベース設定がそのまま使われます。")

                oc1, oc2, oc3 = st.columns([3, 2, 1])
                with oc1:
                    mat_options = material_df_sk.assign(
                        label=material_df_sk['原料JAN'].astype(str) + ' / ' + material_df_sk['原料名']
                    )
                    sel_label = st.selectbox(
                        "原料", mat_options['label'].tolist(),
                        key=f"sk_ovr_add_mat_{selected_store}",
                    )
                    sel_jan = sel_label.split(' / ')[0] if sel_label else None
                with oc2:
                    sel_flag = st.selectbox(
                        "この店舗での扱い", ["対象にする（追加）", "対象から外す（除外）"],
                        key=f"sk_ovr_add_flag_{selected_store}",
                    )
                with oc3:
                    st.markdown(" ")
                    if st.button("追加", key=f"sk_ovr_add_btn_{selected_store}"):
                        flag_val = 'TRUE' if sel_flag.startswith('対象にする') else 'FALSE'
                        new_row = pd.DataFrame([{
                            '店舗名': selected_store, '原料JAN': sel_jan, '仕込み対象': flag_val,
                        }])
                        keep = ~((override_df['店舗名'] == selected_store) &
                                 (override_df['原料JAN'] == sel_jan))
                        save_shikomi_target_store_override(
                            pd.concat([override_df[keep], new_row], ignore_index=True)
                        )
                        st.success("店舗別の上書きを追加しました。")
                        st.rerun()

                if len(store_override) > 0:
                    show_df = store_override.merge(
                        material_df_sk[['原料JAN', '原料名', '原料区分']],
                        on='原料JAN', how='left',
                    )[['原料JAN', '原料名', '原料区分', '仕込み対象']]
                    st.dataframe(show_df, hide_index=True, use_container_width=True)
                    del_jan = st.selectbox(
                        "削除する原料JAN", store_override['原料JAN'].tolist(),
                        key=f"sk_ovr_del_select_{selected_store}",
                    )
                    if st.button("選択した上書きを削除", key=f"sk_ovr_del_btn_{selected_store}"):
                        keep = ~((override_df['店舗名'] == selected_store) &
                                 (override_df['原料JAN'] == del_jan))
                        save_shikomi_target_store_override(override_df[keep].reset_index(drop=True))
                        st.success("店舗別の上書きを削除しました。")
                        st.rerun()


# ========== タブ1：サマリー（最初に異常検知） ==========
# 新設計：3ブロック構成
#   ① データ健全性（この計算結果を信じてよいかのチェック）
#       A. 棚卸の鮮度
#       B. 補正値の状況（A過渡期/B恒久的の集計、TOP10）
#       C. 棚卸推移（複数日ある場合のみ：直近 − 前回の差分TOP）
#   ② 実在庫の分類（期末時点の予測ベース）
#   ③ 各分類の原料一覧（折りたたみ）
#
# ② の分類ツリー：
#   実在庫
#     ├─ 不動：期末残>0 AND 期中の入合計=0 AND 期中の出合計=0
#     └─ 活動：上記以外（期末残>0 AND 動きあり）
#          ├─ 過剰：残 > 安全在庫
#          │    └─ 過α：残 > 安全在庫 × 2.0（過剰の中の極端版・確定値）
#          └─ 不足：残 < 安全在庫
with tab1:
    # サマリーのタイトル・サブタイトルは削除（スペース節約・コントローラーには不要）

    # --------------------------------------------------------
    # 📊 データ反映状況（毎日のデータ取込が正しく反映されているか確認）
    # --------------------------------------------------------
    # 各データテーブルの「いつまでのデータか」と input_processed/ から推定した
    # 「いつ取り込んだか」を種別ごとに表示。判定マークは付けず、武田さんが事実を
    # 見て自分で判断する設計。
    #
    # 最新日付：
    #   ・計画データ：plan['日付_d'].max()
    #   ・実績データ：actual_prod['日付_d'].max()
    #   ・棚卸データ：inventory['棚卸日_d'].max()
    #   ・納品実績  ：actual_del['納品予定日_d'].max()
    #
    # 最終取込日時：input_processed/ 内ファイル更新日時の最大値から推定
    #   ・「実納品数」は「納品予定数」の部分文字列マッチ衝突を避けるため最優先で判定
    st.markdown("### 📊 データ反映状況")

    _loaded_ds = st.session_state.loaded

    def _max_date_ds(df, col):
        if df is None or len(df) == 0 or col not in df.columns:
            return None
        s = df[col].dropna()
        return s.max() if len(s) > 0 else None

    _latest_ds = {
        'plan':        _max_date_ds(_loaded_ds.get('plan'),        '日付_d'),
        'actual_prod': _max_date_ds(_loaded_ds.get('actual_prod'), '日付_d'),
        'inventory':   _max_date_ds(_loaded_ds.get('inventory'),   '棚卸日_d'),
        'actual_del':  _max_date_ds(_loaded_ds.get('actual_del'),  '納品予定日_d'),
    }

    _ip_dir_ds = Path(__file__).parent / 'input_processed'
    _ingest_ds = {'plan': None, 'actual_prod': None, 'inventory': None, 'actual_del': None}
    if _ip_dir_ds.exists():
        _mtimes_ds = {k: [] for k in _ingest_ds}
        for _f_ds in _ip_dir_ds.iterdir():
            if not _f_ds.is_file() or _f_ds.suffix.lower() != '.csv':
                continue
            _name_ds = _f_ds.name
            _mt_ds = _f_ds.stat().st_mtime
            if '実納品数' in _name_ds:
                _mtimes_ds['actual_del'].append(_mt_ds)
            elif '納品予定数' in _name_ds or '計画数' in _name_ds:
                _mtimes_ds['plan'].append(_mt_ds)
            elif '製造数' in _name_ds:
                _mtimes_ds['actual_prod'].append(_mt_ds)
            elif '棚卸' in _name_ds:
                _mtimes_ds['inventory'].append(_mt_ds)
        for _k_ds, _lst_ds in _mtimes_ds.items():
            if _lst_ds:
                _ingest_ds[_k_ds] = datetime.datetime.fromtimestamp(max(_lst_ds))

    def _fmt_date_ds(d):
        return d.strftime('%Y/%m/%d') if d else '-'

    def _fmt_dt_ds(dt):
        return dt.strftime('%Y/%m/%d %H:%M') if dt else '-'

    _rows_ds = [
        ('計画データ', _latest_ds['plan'],        _ingest_ds['plan']),
        ('実績データ', _latest_ds['actual_prod'], _ingest_ds['actual_prod']),
        ('棚卸データ', _latest_ds['inventory'],   _ingest_ds['inventory']),
        ('納品実績  ', _latest_ds['actual_del'],  _ingest_ds['actual_del']),
    ]
    _md_ds = "\n".join(
        f"- **{_label}**：{_fmt_date_ds(_d)} まで（最終取込 {_fmt_dt_ds(_dt)}）"
        for _label, _d, _dt in _rows_ds
    )
    st.markdown(_md_ds)
    st.divider()

    # --------------------------------------------------------
    # ⓪ 今日の余裕日数（コントローラーが朝一に見るべき指標）
    # --------------------------------------------------------
    # 「現在残 ÷ 1日あたり使用予定量 = 余裕日数」を計算し、短い順に並べる。
    # コントローラーの「今日・明日、何か起きそうか」という時間軸に応える。
    #
    # 仕様：
    #   ・現在残：df_actual の today（または最も近い日付）の残を使用
    #            → 棚卸日から今日までを実績ベースで推移させた値
    #   ・1日あたり使用量：df_plan の today～today+7日の「出」の平均
    #            → 直近1週間の使用予定量
    #   ・閾値：🚨危険 <2日 / ⚠️注意 2〜4日 / ✅安全 >4日（2026/5/13 改定）
    #     根拠：発注締め時刻＋納品リードタイムを考慮した運用アクションライン
    #           （詳細は CLAUDE.md §4.0.1「閾値の業務的根拠」参照）
    #   ・「出」が0の原料（使用予定なし）は対象外
    st.markdown("### ⓪ 今日の余裕日数")
    st.caption("現在の在庫が、これから1週間の使用予定に対して何日分もつか。短い順に表示")
    
    today = datetime.date.today()
    
    if len(df_actual) > 0 and len(df_plan) > 0:
        # ---- 1日あたり使用予定量（直近1週間平均）を原料ごとに算出 ----
        week_end = today + datetime.timedelta(days=7)
        df_plan_week = df_plan[
            (df_plan['日付'] >= today) & 
            (df_plan['日付'] <= week_end)
        ].copy()
        usage_per_day = df_plan_week.groupby('原料JAN')['出'].mean().reset_index()
        usage_per_day.columns = ['原料JAN', '1日使用量']
        
        # ---- 現在残（today時点の推定残） ----
        if today in df_actual['日付'].values:
            current = df_actual[df_actual['日付'] == today].copy()
        else:
            past_dates = df_actual[df_actual['日付'] <= today]['日付']
            if len(past_dates) > 0:
                ref_date = past_dates.max()
                current = df_actual[df_actual['日付'] == ref_date].copy()
            else:
                ref_date = df_actual['日付'].min()
                current = df_actual[df_actual['日付'] == ref_date].copy()
        current = current[['原料JAN', '原料名', '原料区分', '残']].rename(columns={'残': '現在残'})
        
        # ---- マージして余裕日数を計算 ----
        df_buffer = current.merge(usage_per_day, on='原料JAN', how='left')
        df_buffer['1日使用量'] = df_buffer['1日使用量'].fillna(0)
        
        df_active = df_buffer[df_buffer['1日使用量'] > 0].copy()
        
        if len(df_active) > 0:
            df_active['余裕日数'] = df_active['現在残'] / df_active['1日使用量']
            df_active = df_active.sort_values('余裕日数')
            
            danger = df_active[df_active['余裕日数'] < 2]
            caution = df_active[(df_active['余裕日数'] >= 2) & (df_active['余裕日数'] <= 4)]
            safe = df_active[df_active['余裕日数'] > 4]

            mcol1, mcol2, mcol3, mcol4 = st.columns(4)
            mcol1.metric("🚨 危険（2日未満）", f"{len(danger)}件")
            mcol2.metric("⚠️ 注意（2〜4日）", f"{len(caution)}件")
            mcol3.metric("✅ 安全（4日超）", f"{len(safe)}件")
            mcol4.metric("📦 集計対象", f"{len(df_active)}件", help="使用予定がある原料のみ")
            
            st.caption(
                f"※ 集計基準日：{today}　/　使用量算出期間：{today}〜{week_end}（1週間平均）　/　"
                f"使用予定なし {len(df_buffer) - len(df_active)} 件は対象外（②期末分類で確認）"
            )
            
            critical = pd.concat([danger, caution]).sort_values('余裕日数')
            
            if len(critical) > 0:
                st.markdown("**🚨 危険／⚠️注意 の原料一覧（余裕日数の短い順）**")
                
                disp = critical[['原料JAN', '原料名', '原料区分', '現在残', '1日使用量', '余裕日数']].copy()
                disp['余裕日数'] = disp['余裕日数'].round(1)
                disp['現在残'] = disp['現在残'].round(1)
                disp['1日使用量'] = disp['1日使用量'].round(2)
                def _state(v):
                    if v < 2:
                        return '🚨 危険'
                    elif v <= 4:
                        return '⚠️ 注意'
                    else:
                        return '✅ 安全'
                disp.insert(0, '状態', disp['余裕日数'].apply(_state))
                
                # 列順を「重要な順」に並べ替え（状態 → 余裕日数 → 原料名 → 数値 → 区分 → JAN）
                disp = disp[['状態', '余裕日数', '原料名', '現在残', '1日使用量', '原料区分', '原料JAN']]
                
                st.dataframe(
                    disp,
                    use_container_width=True,
                    hide_index=True,
                    # 行高を大きめに：1行50px × 件数 + ヘッダー60px
                    height=min(550, 60 + len(disp) * 50),
                    row_height=50,
                    column_config={
                        '状態': st.column_config.TextColumn('状態', width=90, pinned=True),
                        '余裕日数': st.column_config.NumberColumn(
                            '余裕日数', format='%.1f日', width=100,
                            help='現在残÷1日使用量（小さいほど危険）',
                        ),
                        '原料名': st.column_config.TextColumn('原料名', width='large', pinned=True),
                        '現在残': st.column_config.NumberColumn('現在残', format='%.1f', width=90),
                        '1日使用量': st.column_config.NumberColumn('1日使用量', format='%.2f', width=100),
                        '原料区分': st.column_config.TextColumn('区分', width=90),
                        '原料JAN': st.column_config.TextColumn('JAN', width=120),
                    },
                )
                st.caption("💡 危険／注意の原料は、発注システムで増減調整の対象になります。詳細は「📈 計画上の在庫推移」タブで確認できます。")
            else:
                st.success("✅ 危険・注意域の原料はありません（すべて安全域）")
            
            # --------------------------------------------------------
            # 📤 サマリーをGoogle Chatに共有
            # --------------------------------------------------------
            with st.expander("📤 このサマリーをGoogle Chatに共有する", expanded=False):
                # メッセージを生成
                now_str = datetime.datetime.now().strftime('%Y-%m-%d %H:%M')
                msg_lines = [
                    f"🏪 *{selected_store}*（{now_str} 時点）",
                    "",
                    "📊 *余裕日数サマリー*",
                    f"🚨 危険：{len(danger)}件",
                    f"⚠️ 注意：{len(caution)}件",
                    f"✅ 安全：{len(safe)}件",
                ]
                
                # 危険原料 TOP5
                if len(danger) > 0:
                    msg_lines.append("")
                    msg_lines.append(f"🚨 *危険原料 TOP{min(5, len(danger))}*")
                    for _, r in danger.head(5).iterrows():
                        msg_lines.append(
                            f"・{r['原料名']}（余裕 {r['余裕日数']:.1f}日）"
                        )
                
                # 注意原料 TOP3（危険が少ない時のみ）
                if len(danger) < 3 and len(caution) > 0:
                    msg_lines.append("")
                    msg_lines.append(f"⚠️ *注意原料 TOP{min(3, len(caution))}*")
                    for _, r in caution.head(3).iterrows():
                        msg_lines.append(
                            f"・{r['原料名']}(余裕 {r['余裕日数']:.1f}日)"
                        )
                
                msg_lines.extend([
                    "",
                    f"📅 期首：{opening_date}",
                    f"🎯 実績指定日：{params['target_date']}",
                    f"🔧 補正適用：{adj_count}原料",
                ])
                
                if managed_jans_config and managed_jans_config.get('jans'):
                    msg_lines.append(f"🎯 管理対象：{len(managed_jans_config['jans'])}原料に絞り込み中")
                
                share_message = "\n".join(msg_lines)
                
                # プレビュー
                st.markdown("**送信されるメッセージ（プレビュー）:**")
                st.code(share_message, language=None)
                
                # 送信ボタン or コピー用テキスト
                webhook_url = load_webhook_url()
                if webhook_url:
                    if st.button(
                        "📤 Google Chatに送信",
                        type='primary',
                        use_container_width=True,
                        key='_send_chat_btn',
                    ):
                        with st.spinner("送信中..."):
                            result = send_to_google_chat(share_message, webhook_url)
                        if result is True:
                            st.success("✅ Google Chatに送信しました")
                        else:
                            st.error(f"❌ {result}")
                    st.caption(
                        "💡 送信先のGoogle Chatスペースを変更したい場合は、"
                        "「🛠️ 管理者設定」タブで Webhook URL を更新してください"
                    )
                else:
                    st.warning(
                        "⚠️ Google Chatの Webhook URL が未設定です。"
                        "上のテキストをコピーしてGoogle Chatに手動で貼り付けてください。"
                    )
                    st.caption(
                        "💡 自動送信したい場合は、「🛠️ 管理者設定」タブで Webhook URL を設定してください。"
                    )
        else:
            st.info("ℹ️ 使用予定がある原料がありません（計画期間や日付範囲を確認してください）")
    else:
        st.info("ℹ️ 計算データが揃っていません")
    
    st.divider()
    
    # --------------------------------------------------------
    # ① データ健全性（計算結果を信じてよいかのチェック）
    # --------------------------------------------------------
    st.markdown("### ① データ健全性")
    st.caption("②③の分類結果を解釈する前に、入力データと補正の状態を確認する")
    
    # ---- A. 棚卸の鮮度 ----
    # 直近棚卸日からの経過日数。長いほど計算結果の信頼度が下がる。
    today = datetime.date.today()
    days_since_inv = None
    if opening_date is not None:
        try:
            days_since_inv = (today - opening_date).days
        except Exception:
            days_since_inv = None
    
    # ---- B. 補正値の状況 ----
    # 補正値そのものではなく「補正値の付き方」を集計する。
    # CLAUDE.md §7.2 の運用観点：
    #   A 過渡期が多い → データ整備で改善余地
    #   B 恒久的が安定 → 現場の実態が掴めている
    store_adj_full = {
        jan: data
        for (s, jan), data in st.session_state.adjustments.items()
        if s == selected_store
    }
    # 「補正値が0でもメモだけ残す」ケースがあるので、評価は補正値ベースで分ける
    adj_active = {jan: d for jan, d in store_adj_full.items() if d.get('補正値', 0) != 0}
    n_adj_total = len(adj_active)
    n_adj_a = sum(1 for d in adj_active.values() if d.get('種別') == 'A過渡期')
    n_adj_b = sum(1 for d in adj_active.values() if d.get('種別') == 'B恒久的')
    sum_abs_adj = sum(abs(float(d.get('補正値', 0) or 0)) for d in adj_active.values())
    
    # ---- C. 棚卸推移の有無を判定 ----
    inv_all_store = loaded['inventory'][loaded['inventory']['店舗名'] == selected_store].copy()
    inv_dates = sorted(inv_all_store['棚卸日_d'].dropna().unique())
    has_multi_inv = len(inv_dates) >= 2
    
    # ---- メトリクス（A・Bを横並び）----
    mc = st.columns(4)
    if days_since_inv is None:
        mc[0].metric("📅 棚卸からの経過", "-", help="棚卸日が取得できません")
    else:
        # 鮮度の感覚値：3日以内=◎、7日以内=○、それ以上=注意
        if days_since_inv <= 3:
            label = "新しい"
        elif days_since_inv <= 7:
            label = "やや古い"
        else:
            label = "古い"
        mc[0].metric(
            "📅 棚卸からの経過",
            f"{days_since_inv} 日",
            help=f"直近棚卸日：{opening_date}（{label}）"
        )
    mc[1].metric("🔧 補正適用中", f"{n_adj_total} 原料", help=f"｜補正値｜の合計：{sum_abs_adj:.1f}")
    mc[2].metric("　└ A 過渡期", n_adj_a, help="データ整備で本来は解消すべきズレ")
    mc[3].metric("　└ B 恒久的", n_adj_b, help="業務上、構造的に発生するズレ")
    
    # ---- B. 補正値が大きい原料 TOP（折りたたみ）----
    if n_adj_total > 0:
        with st.expander(f"補正値が大きい原料 TOP10（{n_adj_total} 原料中）", expanded=False):
            mat_idx = loaded['material'][['原料JAN', '原料名', '原料区分']].drop_duplicates(subset=['原料JAN'])
            adj_rows = []
            for jan, d in adj_active.items():
                val = float(d.get('補正値', 0) or 0)
                adj_rows.append({
                    '原料JAN': jan,
                    '補正値': val,
                    '｜補正値｜': abs(val),
                    '種別': d.get('種別', ''),
                    'メモ': d.get('メモ', ''),
                })
            df_adj = pd.DataFrame(adj_rows).merge(mat_idx, on='原料JAN', how='left')
            df_adj = df_adj.sort_values('｜補正値｜', ascending=False).head(10)
            disp_adj = df_adj[['原料名', '原料区分', '種別', '補正値', 'メモ']].copy()
            disp_adj['補正値'] = disp_adj['補正値'].round(1)
            st.dataframe(disp_adj, use_container_width=True, hide_index=True)
            st.caption(
                "※ A過渡期はデータ整備チームに連携、B恒久的は安定値かを定期確認"
            )
    
    # ---- C. 棚卸推移（複数日ある場合のみ）----
    if has_multi_inv:
        latest_date = inv_dates[-1]
        prev_date = inv_dates[-2]
        with st.expander(f"棚卸推移：{prev_date} → {latest_date} の変化が大きい原料 TOP10", expanded=False):
            inv_latest = inv_all_store[inv_all_store['棚卸日_d'] == latest_date].groupby('JAN')['棚卸数'].sum()
            inv_prev = inv_all_store[inv_all_store['棚卸日_d'] == prev_date].groupby('JAN')['棚卸数'].sum()
            # 両方の和集合で比較（片方しかなければ 0 として扱う）
            all_jans = set(inv_latest.index) | set(inv_prev.index)
            diff_rows = []
            for jan in all_jans:
                v_now = float(inv_latest.get(jan, 0) or 0)
                v_prev = float(inv_prev.get(jan, 0) or 0)
                diff_rows.append({
                    '原料JAN': jan,
                    f'{prev_date}': v_prev,
                    f'{latest_date}': v_now,
                    '差分': v_now - v_prev,
                    '｜差分｜': abs(v_now - v_prev),
                })
            df_diff = pd.DataFrame(diff_rows)
            df_diff = df_diff[df_diff['｜差分｜'] > 0]  # 変化なしは除外
            mat_idx2 = loaded['material'][['原料JAN', '原料名', '原料区分']].drop_duplicates(subset=['原料JAN'])
            df_diff = df_diff.merge(mat_idx2, on='原料JAN', how='left')
            df_diff = df_diff.sort_values('｜差分｜', ascending=False).head(10)
            
            if len(df_diff) > 0:
                disp_diff = df_diff[['原料名', '原料区分', f'{prev_date}', f'{latest_date}', '差分']].copy()
                for col in [f'{prev_date}', f'{latest_date}', '差分']:
                    disp_diff[col] = disp_diff[col].round(1)
                st.dataframe(disp_diff, use_container_width=True, hide_index=True)
                st.caption(
                    "※ 差分は『生の棚卸数の差』であり、期間中の入出庫を含む。"
                    "純粋な論理-実のズレではなく、参考情報として表示。"
                )
            else:
                st.info("変化のある原料はありません")
    else:
        st.caption(f"📌 棚卸推移：単一日（{opening_date}）のみのため非表示")
    
    st.divider()
    
    # --------------------------------------------------------
    # ② 実在庫の分類（期末時点の予測ベース）
    # --------------------------------------------------------
    st.markdown("### ② 実在庫の分類（期末時点）")
    st.caption("計画通りに進んだ場合の期末時点で、各原料がどの状態になるかを分類")
    
    # df_plan（計画上）をベースに分類する
    # 期末（最終日）の状態と、期間中の入出合計を見る
    if len(df_plan) > 0:
        # 各原料ごとに期間中の入出合計、期末の残・安全在庫を集計
        agg = df_plan.groupby('原料JAN').agg(
            原料名=('原料名', 'first'),
            原料区分=('原料区分', 'first'),
            入合計=('入', 'sum'),
            出合計=('出', 'sum'),
        ).reset_index()
        
        # 期末（=最終日）の残と安全在庫を取る
        last_date = df_plan['日付'].max()
        df_last = df_plan[df_plan['日付'] == last_date][['原料JAN', '残', '安全在庫']].rename(
            columns={'残': '期末残', '安全在庫': '期末安全在庫'}
        )
        agg = agg.merge(df_last, on='原料JAN', how='left')
        agg['期末残'] = agg['期末残'].fillna(0)
        agg['期末安全在庫'] = agg['期末安全在庫'].fillna(0)
        
        # 分類ロジック
        def classify(row):
            zan = row['期末残']
            anz = row['期末安全在庫']
            in_sum = row['入合計']
            out_sum = row['出合計']
            
            # 期末残が無ければ「実在庫なし」
            if zan <= 0:
                return '在庫なし'
            
            # 不動：期末残あり AND 期間中の入出ゼロ
            if in_sum == 0 and out_sum == 0:
                return '不動'
            
            # 活動の中での分類
            if zan < anz:
                return '不足'
            elif zan > anz * 2:
                return '過α'
            elif zan > anz:
                return '過剰'
            else:
                return '活動（適正）'
        
        agg['分類'] = agg.apply(classify, axis=1)
        
        n_fudou = (agg['分類'] == '不動').sum()
        n_kaa = (agg['分類'] == '過α').sum()
        n_busoku = (agg['分類'] == '不足').sum()
        n_kajou = (agg['分類'] == '過剰').sum()  # 過αを含まない通常の過剰
        n_katsudo = (agg['分類'] == '活動（適正）').sum()
        n_zero = (agg['分類'] == '在庫なし').sum()
        n_total = len(agg)
        
        # メトリクス（最優先異常を左に）
        c = st.columns(6)
        c[0].metric("🔴 不動", n_fudou, help="最優先異常：期末残あり×期中の動きなし")
        c[1].metric("🔴 過α", n_kaa, help="安全在庫の2倍超の過剰")
        c[2].metric("🟡 不足", n_busoku, help="残 < 安全在庫")
        c[3].metric("⚪ 過剰", n_kajou, help="安全在庫超〜2倍以下")
        c[4].metric("🟢 活動(適正)", n_katsudo, help="安全在庫付近で動いている")
        c[5].metric("在庫なし", n_zero, help="期末残ゼロ")
        
        # 構成比バー（合計から「在庫なし」を除外して表示）
        n_jitsu = n_total - n_zero  # 実在する原料
        if n_jitsu > 0:
            bar2 = f"""
            <div style="display:flex; height:24px; border-radius:4px; overflow:hidden; margin:8px 0; border:1px solid #ddd;">
                <div style="width:{n_fudou/n_jitsu*100:.1f}%; background:#e53935;" title="不動 {n_fudou}"></div>
                <div style="width:{n_kaa/n_jitsu*100:.1f}%; background:#ef5350;" title="過α {n_kaa}"></div>
                <div style="width:{n_busoku/n_jitsu*100:.1f}%; background:#ffd54f;" title="不足 {n_busoku}"></div>
                <div style="width:{n_kajou/n_jitsu*100:.1f}%; background:#bdbdbd;" title="過剰 {n_kajou}"></div>
                <div style="width:{n_katsudo/n_jitsu*100:.1f}%; background:#81c784;" title="活動(適正) {n_katsudo}"></div>
            </div>
            <div style="font-size:0.85rem; color:#666;">
                実在原料 {n_jitsu} 件中：
                不動 {n_fudou/n_jitsu*100:.1f}% ／
                過α {n_kaa/n_jitsu*100:.1f}% ／
                不足 {n_busoku/n_jitsu*100:.1f}% ／
                過剰 {n_kajou/n_jitsu*100:.1f}% ／
                活動 {n_katsudo/n_jitsu*100:.1f}%
            </div>
            """
            st.markdown(bar2, unsafe_allow_html=True)
        
        # ----------------------------------------------------
        # ③ 各分類の原料一覧（折りたたみ）
        # ----------------------------------------------------
        st.markdown("### ③ 異常分類別の原料一覧")
        st.caption("各分類の表の下にあるセレクトで原料を選び、『📊 推移を見る』を押すと計画／実績の在庫推移タブで該当原料に絞り込まれます。")
        
        def show_class_list(label, cls_name, color_label):
            df_cls = agg[agg['分類'] == cls_name].copy()
            count = len(df_cls)
            with st.expander(f"{color_label} {label}（{count}件）", expanded=False):
                if count == 0:
                    st.info("該当なし")
                    return
                # 重要度順に並べる
                if cls_name == '不動':
                    df_cls = df_cls.sort_values('期末残', ascending=False)
                elif cls_name == '過α':
                    df_cls['超過倍率'] = df_cls['期末残'] / df_cls['期末安全在庫'].replace(0, 1)
                    df_cls = df_cls.sort_values('超過倍率', ascending=False)
                elif cls_name == '不足':
                    df_cls['不足量'] = df_cls['期末安全在庫'] - df_cls['期末残']
                    df_cls = df_cls.sort_values('不足量', ascending=False)
                
                # 上位100件に制限
                df_cls_view = df_cls.head(100).copy()
                
                # 表は読み取り専用で表示
                disp = df_cls_view[['原料JAN', '原料名', '原料区分', '期末残', '期末安全在庫', '入合計', '出合計']].copy()
                for col in ['期末残', '期末安全在庫', '入合計', '出合計']:
                    disp[col] = disp[col].round(1)
                st.dataframe(disp, use_container_width=True, hide_index=True)
                
                if count > 100:
                    st.caption(f"※ 上位100件を表示（全{count}件）")
                
                # 原料選択（multiselect）
                # value は 原料JAN、表示ラベルは「原料名（JAN）」
                jan_to_label = {
                    r['原料JAN']: f"{r['原料名']}（{r['原料JAN']}）"
                    for _, r in df_cls_view.iterrows()
                }
                selected_jans = st.multiselect(
                    "推移を見たい原料を選択",
                    options=list(jan_to_label.keys()),
                    format_func=lambda j: jan_to_label.get(j, j),
                    key=f"multisel_{cls_name}",
                    placeholder="原料を選んでください（複数選択可）",
                )
                n_sel = len(selected_jans)
                
                bcol1, _bcol2 = st.columns([1, 2])
                with bcol1:
                    btn_clicked = st.button(
                        f"📊 推移を見る（{n_sel}件）",
                        key=f"goto_flow_{cls_name}",
                        disabled=(n_sel == 0),
                        use_container_width=True,
                        help="計画／実績の両方の在庫推移タブで、選択した原料に絞り込まれます",
                    )
                    if btn_clicked:
                        # ファイル経由でタブ間共有
                        focus_jans_file = DATA_DIR / 'focus_jans.txt'
                        try:
                            focus_jans_file.write_text(
                                ','.join(selected_jans), encoding='utf-8'
                            )
                        except Exception as e:
                            st.error(f"保存エラー: {e}")
                        st.toast(
                            f"{n_sel}件を選択しました。"
                            "「📈 計画上の在庫推移」または「📋 実績上の在庫推移」タブを開いてください。"
                        )
        
        show_class_list("不動", '不動', '🔴')
        show_class_list("過α（安全在庫の2倍超）", '過α', '🔴')
        show_class_list("不足", '不足', '🟡')
        show_class_list("過剰", '過剰', '⚪')
        show_class_list("活動（適正）", '活動（適正）', '🟢')
    else:
        st.warning("計画データがないため、分類できません")
    
    st.divider()
    
    # --------------------------------------------------------
    # 現在のチューニング設定（参考表示）
    # --------------------------------------------------------
    with st.expander("ℹ️ 現在のチューニング設定（参考）", expanded=False):
        p_col = st.columns(3)
        p_col[0].info(f"**基準日数**\n\n{params['base_days']} 日")
        p_col[1].info(f"**歩留(不測)**\n\n{params['yield_fusoku']:.2f}")
        p_col[2].info(f"**歩留(可測)**\n\n{params['yield_kasoku']:.2f}")


# ========== タブ4：ズレ補正 ==========
with tab4:
    st.subheader(f"🔧 ズレ補正（{selected_store}）")
    st.caption(
        "**論理在庫と実在庫のズレを原料ごとに補正します。**"
        " 棚卸数（期首在庫）に補正値が加算されます。"
    )
    
    with st.expander("ℹ️ 種別の使い分け", expanded=False):
        st.markdown("""
        **A 過渡期**：データ整備で本来は解消すべきズレ。
        
        - 例：マスタの不備、データ計上漏れ、システム連携の遅延
        - これらは齋藤さん・松本君に渡して仕組みで解消する材料
        - 「いずれは0にしたい」補正
        
        **B 恒久的**：業務上、構造的に発生し続けるズレ。
        
        - 例：計量ロス、テスト分、切れ端の再利用
        - これは仕組みで解消できないため、アプリで補正し続ける
        - 補正値が安定しているもの
        """)
    
    # 既存補正の取得
    store_adjustments = {
        jan: data for (s, jan), data in st.session_state.adjustments.items()
        if s == selected_store
    }
    
    # 補正対象の原料リスト
    material_df_for_select = loaded['material'].copy()
    
    # 検索フィルタ
    col_a, col_b, col_c = st.columns([2, 1, 1])
    with col_a:
        search = st.text_input("🔍 原料名で検索", "", key='adj_search')
    with col_b:
        filter_kbn = st.selectbox(
            "種別でフィルタ",
            ['すべて', 'A過渡期のみ', 'B恒久的のみ', '補正設定済みのみ'],
            key='adj_filter'
        )
    with col_c:
        st.write("")
        st.write("")
        if st.button("💾 変更を保存", type="primary", use_container_width=True):
            save_adjustments_to_disk(st.session_state.adjustments)
            st.success("保存しました")
    
    # 表示する原料を決定
    df_show = material_df_for_select.copy()
    if search:
        df_show = df_show[df_show['原料名'].astype(str).str.contains(search, na=False)]
    
    if filter_kbn == '補正設定済みのみ':
        df_show = df_show[df_show['原料JAN'].isin(store_adjustments.keys())]
    elif filter_kbn == 'A過渡期のみ':
        a_jans = [jan for jan, d in store_adjustments.items() if d.get('種別') == 'A過渡期']
        df_show = df_show[df_show['原料JAN'].isin(a_jans)]
    elif filter_kbn == 'B恒久的のみ':
        b_jans = [jan for jan, d in store_adjustments.items() if d.get('種別') == 'B恒久的']
        df_show = df_show[df_show['原料JAN'].isin(b_jans)]
    
    # 設定済み補正のサマリー
    adj_count_a = sum(1 for d in store_adjustments.values() if d.get('種別') == 'A過渡期')
    adj_count_b = sum(1 for d in store_adjustments.values() if d.get('種別') == 'B恒久的')
    sum_col1, sum_col2, sum_col3 = st.columns(3)
    sum_col1.metric("補正設定中", len(store_adjustments))
    sum_col2.metric("A 過渡期", adj_count_a)
    sum_col3.metric("B 恒久的", adj_count_b)
    
    st.divider()
    st.markdown(f"**{len(df_show)} 件の原料を表示**")
    st.caption("補正値を変更して「💾 変更を保存」をクリックすると、計算に反映されます")
    
    # 表示数を制限（パフォーマンスのため）
    if len(df_show) > 100:
        st.warning(f"表示が多すぎます（{len(df_show)}件）。検索やフィルタで絞り込んでください。先頭100件のみ表示します。")
        df_show = df_show.head(100)
    
    # 各原料に対して補正設定UIを表示
    for _, row in df_show.iterrows():
        jan = row['原料JAN']
        name = row['原料名']
        kubun = row.get('原料区分', '')
        
        existing = store_adjustments.get(jan, {})
        cur_val = existing.get('補正値', 0.0)
        cur_kind = existing.get('種別', 'A過渡期')
        cur_memo = existing.get('メモ', '')
        cur_updated = existing.get('更新日', '')
        
        # 補正がある原料は強調表示
        bg = "#fff8e1" if cur_val != 0 else "transparent"
        
        with st.container():
            cols = st.columns([3, 1, 1, 3, 1])
            cols[0].markdown(f"**{name}**  \n<small style='color:#888'>{kubun} ｜ JAN: {jan}</small>", unsafe_allow_html=True)
            
            new_val = cols[1].number_input(
                "補正値", value=float(cur_val), step=1.0,
                key=f"adj_val_{jan}",
                label_visibility="collapsed",
            )
            
            new_kind = cols[2].selectbox(
                "種別",
                ['A過渡期', 'B恒久的'],
                index=0 if cur_kind == 'A過渡期' else 1,
                key=f"adj_kind_{jan}",
                label_visibility="collapsed",
            )
            
            new_memo = cols[3].text_input(
                "メモ", value=cur_memo,
                key=f"adj_memo_{jan}",
                label_visibility="collapsed",
                placeholder="補正の理由（例：計量ロス、テスト分）"
            )
            
            cols[4].caption(cur_updated if cur_updated else "未設定")
            
            # 値が変わったらセッションに反映（保存ボタンで永続化）
            if new_val != cur_val or new_kind != cur_kind or new_memo != cur_memo:
                if new_val == 0 and not new_memo:
                    # ゼロかつメモなしなら削除
                    if (selected_store, jan) in st.session_state.adjustments:
                        del st.session_state.adjustments[(selected_store, jan)]
                else:
                    st.session_state.adjustments[(selected_store, jan)] = {
                        '補正値': new_val,
                        '種別': new_kind,
                        'メモ': new_memo,
                        '更新日': datetime.date.today().strftime('%Y-%m-%d'),
                    }


# ========== タブ5：シミュレーター ==========
with tab5:
    st.subheader(f"🔬 パラメータ Before/After シミュレーター（{selected_store}）")
    st.caption(
        "**「もしパラメータをこう変えたら、どう変わるか」を試す機能**"
        " ｜ 現在の設定値を変えずに、仮の値で計算結果を比較できます"
    )
    
    # 仮パラメータ設定UI
    sim_cols = st.columns(3)
    with sim_cols[0]:
        st.markdown("**A：現在の設定（参考）**")
        st.info(
            f"基準日数：{params['base_days']} 日  \n"
            f"歩留（不測）：{params['yield_fusoku']:.2f}  \n"
            f"歩留（可測）：{params['yield_kasoku']:.2f}"
        )
    
    with sim_cols[1]:
        st.markdown("**B：仮の設定**")
        sim_base = st.number_input(
            "基準日数", min_value=1, max_value=14,
            value=params['base_days'], step=1, key='sim_base'
        )
        sim_fusoku = st.number_input(
            "歩留（不測）", min_value=0.1, max_value=1.0,
            value=params['yield_fusoku'], step=0.05, format="%.2f", key='sim_fusoku'
        )
        sim_kasoku = st.number_input(
            "歩留（可測）", min_value=0.1, max_value=1.0,
            value=params['yield_kasoku'], step=0.05, format="%.2f", key='sim_kasoku'
        )
    
    with sim_cols[2]:
        st.markdown("**変更内容**")
        diff_msg = []
        if sim_base != params['base_days']:
            diff_msg.append(f"基準日数 {params['base_days']}→{sim_base} 日")
        if abs(sim_fusoku - params['yield_fusoku']) > 0.001:
            diff_msg.append(f"歩留(不測) {params['yield_fusoku']:.2f}→{sim_fusoku:.2f}")
        if abs(sim_kasoku - params['yield_kasoku']) > 0.001:
            diff_msg.append(f"歩留(可測) {params['yield_kasoku']:.2f}→{sim_kasoku:.2f}")
        
        if diff_msg:
            for m in diff_msg:
                st.warning(m)
        else:
            st.success("変更なし")
    
    if not diff_msg:
        st.info("👆 仮の設定を変更すると、Before/After比較が表示されます")
    else:
        st.divider()
        
        # 仮パラメータでも計算
        with st.spinner("仮の設定で再計算中..."):
            df_plan_sim = calculate_flow_cached(
                selected_store,
                target_date=None,
                base_days=sim_base,
                yield_fusoku=sim_fusoku,
                yield_kasoku=sim_kasoku,
                adjustments=current_adjustments,
            )
        
        if len(df_plan_sim) == 0 or len(df_plan) == 0:
            st.warning("計算結果がありません")
        else:
            # 全原料サマリー比較
            st.markdown("### 📊 全原料サマリー比較（計画モード）")
            
            # 各原料ごとに、差マイナス日数の変化を集計
            def summarize(df):
                return df.groupby('原料JAN').agg(
                    原料名=('原料名', 'first'),
                    原料区分=('原料区分', 'first'),
                    差マイナス日数=('差', lambda x: (x < 0).sum()),
                    最小差=('差', 'min'),
                    平均安全在庫=('安全在庫', 'mean'),
                ).reset_index()
            
            sum_a = summarize(df_plan).rename(columns={
                '差マイナス日数': '差マイナス_A',
                '最小差': '最小差_A',
                '平均安全在庫': '平均安全在庫_A',
            })
            sum_b = summarize(df_plan_sim).rename(columns={
                '差マイナス日数': '差マイナス_B',
                '最小差': '最小差_B',
                '平均安全在庫': '平均安全在庫_B',
            })
            
            merged = sum_a.merge(
                sum_b[['原料JAN', '差マイナス_B', '最小差_B', '平均安全在庫_B']],
                on='原料JAN', how='outer'
            ).fillna(0)
            
            # 変化量を計算
            merged['差マイナス変化'] = merged['差マイナス_B'] - merged['差マイナス_A']
            merged['安全在庫変化率'] = (
                (merged['平均安全在庫_B'] - merged['平均安全在庫_A']) /
                merged['平均安全在庫_A'].replace(0, 1) * 100
            ).round(1)
            
            # サマリー指標
            m_col = st.columns(4)
            
            tot_a = int(merged['差マイナス_A'].sum())
            tot_b = int(merged['差マイナス_B'].sum())
            change = tot_b - tot_a
            
            m_col[0].metric("差マイナス日数（A）", tot_a)
            m_col[1].metric("差マイナス日数（B）", tot_b, delta=int(change), delta_color="inverse")
            
            worse_count = int((merged['差マイナス変化'] > 0).sum())
            better_count = int((merged['差マイナス変化'] < 0).sum())
            m_col[2].metric("悪化した原料", worse_count, delta_color="inverse")
            m_col[3].metric("改善した原料", better_count)
            
            st.divider()
            
            # 変化の大きい原料を表示
            st.markdown("### 🔍 影響が大きい原料 TOP20")
            
            # 変化量で並び替え
            merged['変化絶対値'] = merged['差マイナス変化'].abs()
            top_changed = merged.sort_values('変化絶対値', ascending=False).head(20)
            
            display_df = top_changed[[
                '原料名', '原料区分',
                '差マイナス_A', '差マイナス_B', '差マイナス変化',
                '平均安全在庫_A', '平均安全在庫_B', '安全在庫変化率',
            ]].copy()
            display_df.columns = [
                '原料名', '原料区分',
                'A:差マイナス日数', 'B:差マイナス日数', '日数変化',
                'A:平均安全在庫', 'B:平均安全在庫', '安全在庫変化率(%)',
            ]
            
            display_df['A:平均安全在庫'] = display_df['A:平均安全在庫'].round(1)
            display_df['B:平均安全在庫'] = display_df['B:平均安全在庫'].round(1)
            
            st.dataframe(
                display_df,
                use_container_width=True,
                hide_index=True,
                column_config={
                    '日数変化': st.column_config.NumberColumn(
                        '日数変化', format="%+d",
                    ),
                    '安全在庫変化率(%)': st.column_config.NumberColumn(
                        '安全在庫変化率(%)', format="%+.1f%%",
                    ),
                }
            )
            
            st.divider()
            
            # 個別原料の詳細比較
            st.markdown("### 🎯 特定原料の詳細比較")
            
            material_options = sorted(merged['原料名'].dropna().unique().tolist())
            sel_material = st.selectbox(
                "比較したい原料を選択",
                ['（選択してください）'] + material_options,
                key='sim_material',
            )
            
            if sel_material != '（選択してください）':
                sel_jan = merged[merged['原料名'] == sel_material]['原料JAN'].iloc[0]
                detail_a = df_plan[df_plan['原料JAN'] == sel_jan].copy()
                detail_b = df_plan_sim[df_plan_sim['原料JAN'] == sel_jan].copy()
                
                if len(detail_a) > 0 and len(detail_b) > 0:
                    # 日付ごとに横に並べる
                    detail_a_p = detail_a.set_index('日付')[['入', '出', '残', '安全在庫', '差']].copy()
                    detail_b_p = detail_b.set_index('日付')[['入', '出', '残', '安全在庫', '差']].copy()
                    
                    # 差分を計算
                    detail_diff = detail_b_p - detail_a_p
                    
                    detail_a_p.columns = [f'{c}_A' for c in detail_a_p.columns]
                    detail_b_p.columns = [f'{c}_B' for c in detail_b_p.columns]
                    detail_diff.columns = [f'{c}_差分' for c in detail_diff.columns]
                    
                    combined = pd.concat([detail_a_p, detail_b_p, detail_diff], axis=1)
                    combined = combined.reset_index()
                    
                    # 並び順を調整
                    cols_order = ['日付']
                    for item in ['入', '出', '残', '安全在庫', '差']:
                        cols_order.extend([f'{item}_A', f'{item}_B', f'{item}_差分'])
                    combined = combined[cols_order]
                    
                    # 数値を丸める
                    for c in combined.columns:
                        if c != '日付':
                            combined[c] = combined[c].round(2)
                    
                    st.markdown(f"**{sel_material}** の日別比較")
                    st.dataframe(combined, use_container_width=True, hide_index=True, height=400)


# ========== タブ：棚卸カウント確認（2026-05-30 追加） ==========
# 棚卸前に「見込み在庫数」を表示する予習画面。事後アラートではなく、事前の
# メンタルモデル形成で現物カウントの精度を上げる設計思想。計算は新規作成せず
# calculate_flow の日別入/出を期間集計して再利用する（compute_expected_inventory）。
with tab_tana:
    st.subheader("📝 棚卸カウント確認")
    st.caption("棚卸前に「見込み在庫数」を確認し、現物カウントの目安にします（単位：パック）")

    inv_tana = loaded['inventory'][loaded['inventory']['店舗名'] == selected_store]
    inv_tana_dates = sorted(inv_tana['棚卸日_d'].dropna().unique(), reverse=True)

    if len(inv_tana_dates) == 0:
        st.warning(f"⚠️ {selected_store} の棚卸データがありません。")
    else:
        prev_tana_date = inv_tana_dates[0]  # 前回棚卸日 = 直近棚卸日（＝集計起点）

        # 棚卸予定日の選択範囲：前回棚卸日の翌日 〜 計画最終日
        plan_tana = loaded['plan'][loaded['plan']['店舗名'] == selected_store]
        plan_max = plan_tana['日付_d'].dropna().max() if len(plan_tana) else None
        min_sel = prev_tana_date + datetime.timedelta(days=1)
        # 前回棚卸日の翌日以降に計画があるか。
        # 例：粕屋CK は計画が5/24止まりなのに棚卸が5/31だと min_sel(6/1) > plan_max(5/24) になり、
        # st.date_input が min_value>max_value で例外を投げる（2026/6/2 タスクEで顕在化）。
        # 計画がない店舗は棚卸予定日を選べないので、ここで打ち切って警告だけ出す。
        window_ok = (plan_max is not None) and (plan_max >= min_sel)
        # 既定は「今日」（＝今夜カウントする想定日）。実績最終日(actual_max)は通常「昨日」のため、
        # 既定を actual_max にすると今日開いても予定日が昨日になり予習にならない（2026/6/9 武田指摘）。
        # 今日の製造は計画として下の target_date=actual_max 経由で反映される。範囲外はクランプ。
        default_sel = datetime.date.today()
        if plan_max is not None and default_sel > plan_max:
            default_sel = plan_max
        if default_sel < min_sel:
            default_sel = min_sel

        if not window_ok:
            st.warning(
                f"⚠️ {selected_store} は前回棚卸日（{prev_tana_date.strftime('%Y-%m-%d')}）の"
                f"翌日以降の計画データがありません（計画最終日："
                f"{plan_max.strftime('%Y-%m-%d') if plan_max is not None else 'なし'}）。"
                "棚卸予定日を選べないため、見込み在庫数は表示できません。計画データを更新してください。"
            )
            tana_yotei = min_sel  # 形式上の値（下の見込み計算は window_ok=False でスキップ）
        else:
            col1, col2 = st.columns([1.2, 2])
            with col1:
                tana_yotei = st.date_input(
                    "📅 棚卸予定日",
                    value=default_sel,
                    min_value=min_sel,
                    max_value=plan_max,
                    key='tana_yotei_date',
                    help="この日に棚卸する想定で、前回棚卸からの動きを反映した見込み在庫数を出します",
                )
            with col2:
                st.markdown(f"**📋 前回棚卸日**：{prev_tana_date.strftime('%Y-%m-%d')}")
                st.caption(f"集計期間：{min_sel} 〜 {tana_yotei}")

        period_start = prev_tana_date
        period_end = tana_yotei

        # 原料名・区分マップ（マスタ）
        mat_df = loaded['material']
        name_map = dict(zip(mat_df['原料JAN'].astype(str), mat_df['原料名']))
        kubun_map = dict(zip(mat_df['原料JAN'].astype(str), mat_df['原料区分']))

        def _tana_label(j):
            nm = name_map.get(j, '')
            return f"{nm}（{j}）" if nm else j

        override_df = load_tanaoroshi_override()
        base_jans = get_tanaoroshi_inventory_jans(selected_store, loaded, prev_tana_date)

        # ---- 棚卸対象の調整（折りたたみ：補助機能のため畳む） ----
        with st.expander("⚙️ 棚卸対象の調整（この店舗の例外設定）", expanded=False):
            st.caption(
                "デフォルトの棚卸対象は『直近の棚卸に登録されている原料』です。"
                "ここで店舗別に追加・除外できます。"
            )
            cur_ov = override_df[override_df['店舗名'] == selected_store]
            cur_add = set(cur_ov[cur_ov['種別'] == '追加']['原料JAN'].astype(str))
            cur_rem = set(cur_ov[cur_ov['種別'] == '除外']['原料JAN'].astype(str))

            all_jans = sorted(set(mat_df['原料JAN'].astype(str)) - {''})
            add_candidates = [j for j in all_jans if j not in base_jans]
            rem_candidates = sorted(base_jans)

            sel_add = st.multiselect(
                "➕ 追加する原料（棚卸対象に含める）",
                add_candidates,
                default=[j for j in cur_add if j in add_candidates],
                format_func=_tana_label,
                key='tana_add',
            )
            sel_rem = st.multiselect(
                "➖ 除外する原料（棚卸対象から外す）",
                rem_candidates,
                default=[j for j in cur_rem if j in rem_candidates],
                format_func=_tana_label,
                key='tana_rem',
            )
            if st.button("💾 棚卸対象の調整を保存", key='save_tana_override'):
                other = override_df[override_df['店舗名'] != selected_store]
                new_rows = []
                for j in sel_add:
                    new_rows.append({'店舗名': selected_store, '原料JAN': j, '種別': '追加'})
                for j in sel_rem:
                    new_rows.append({'店舗名': selected_store, '原料JAN': j, '種別': '除外'})
                merged_ov = (pd.concat([other, pd.DataFrame(new_rows)], ignore_index=True)
                             if new_rows else other)
                save_tanaoroshi_override(merged_ov)
                st.success("保存しました。画面を更新します。")
                st.rerun()

        # ---- 最終対象セット ----
        target_jans = get_tanaoroshi_targets_for_store(
            selected_store, loaded, prev_tana_date, override_df
        )
        if not window_ok:
            pass  # 計画データがないため見込み計算はスキップ（上で警告済み）
        elif not target_jans:
            st.warning("棚卸対象の原料がありません。")
        else:
            # ---- 見込み在庫数の計算（calculate_flow を再利用） ----
            with st.spinner("見込み在庫数を計算中..."):
                flow_tana = calculate_flow_cached(
                    selected_store,
                    # target_date は実績／計画の境界。棚卸予定日(period_end)ではなく実績最終日に固定する。
                    # period_end を渡すと、棚卸予定日が実績最終日より先のとき その間の日を「実績扱い→空」で
                    # 計上し、当日分の計画製造が無視される（見込み@予定日＝見込み@実績最終日になる）。
                    # 実績最終日で固定すれば 〜実績最終日=実績、それ以降=計画 で延伸し、
                    # 棚卸予定日(=今日)の製造終了後の見込みが正しく出る（2026/6/9 武田指摘）。
                    target_date=actual_max,
                    base_days=params['base_days'],
                    yield_fusoku=params['yield_fusoku'],
                    yield_kasoku=params['yield_kasoku'],
                    adjustments={},  # 見込みは物理カウントの予習のため、ズレ補正は加えない
                )

            # 前回棚卸数（生の棚卸数。補正なし）
            inv_open = inv_tana[inv_tana['棚卸日_d'] == prev_tana_date].copy()
            inv_open['棚卸数_n'] = pd.to_numeric(inv_open['棚卸数'], errors='coerce').fillna(0.0)
            jan_col = 'JAN' if 'JAN' in inv_open.columns else '原料JAN'
            opening_dict = inv_open.groupby(jan_col)['棚卸数_n'].sum().to_dict()

            recs = []
            for j in target_jans:
                vals = compute_expected_inventory(
                    j, flow_tana, opening_dict, period_start, period_end
                )
                recs.append({
                    '原料JAN': j,
                    '原料名': name_map.get(j, '（マスタ未登録）'),
                    '原料区分': kubun_map.get(j, ''),
                    **vals,
                })
            df_tana = pd.DataFrame(recs)

            base_count = len(base_jans)
            final_count = len(target_jans)
            added = len(set(target_jans) - base_jans)
            removed = len(base_jans - set(target_jans))
            st.markdown(
                f"**棚卸対象：{final_count} 原料**"
                f"（ベース {base_count} ＋追加 {added} −除外 {removed}）"
            )
            st.caption("※ 各数値はパック単位で四捨五入して表示しています")
            st.markdown("---")

            # 原料区分でグルーピングして表示（業務的並び順）
            ordered_kubun = get_sorted_material_categories(mat_df, exclude_target_gai=False)
            shown = set()
            disp_cols = ['原料名', '前回棚卸数', '期間入数', '期間出数', '見込み在庫数']

            def _render_tana_table(sub, scope_id):
                d = sub[disp_cols].copy().sort_values('原料名')
                for c in ['前回棚卸数', '期間入数', '期間出数', '見込み在庫数']:
                    d[c] = d[c].round().astype(int)
                d = d.rename(columns={'期間入数': '期間入数(＋)', '期間出数': '期間出数(−)'})
                # タスクG-2：sticky HTML表（原料名固定・文字大・整数右寄せ）。
                render_html_table(
                    d, scope=f"htbl-tana-{scope_id}",
                    pin_cols=['原料名'], pin_widths={'原料名': 240},
                    max_height=520,
                )

            for _ki, kbn in enumerate(ordered_kubun):
                sub = df_tana[df_tana['原料区分'] == kbn]
                if len(sub) == 0:
                    continue
                shown.update(sub['原料JAN'])
                st.markdown(f"#### {kbn}（{len(sub)}）")
                _render_tana_table(sub, _ki)

            rest = df_tana[~df_tana['原料JAN'].isin(shown)]
            if len(rest) > 0:
                st.markdown(f"#### その他・未分類（{len(rest)}）")
                _render_tana_table(rest, 'rest')


# ========== タブ6：棚卸評価（2026/5/14 追加） ==========
# 棚卸結果と論理在庫の乖離を評価し、原料ごとに ◎○△× を付ける。
# セクション構成：
#   1) 詳細評価（在庫集計＋乖離評価×在庫分類クロス集計）
#   2) 横断比較（店舗別の評価分布）
#   3) 時系列推移（選択店舗の棚卸履歴）
with tab6:
    st.subheader("📊 棚卸評価")

    # ---- 上部：棚卸日選択 / 店舗情報 / 前回棚卸日表示 ----
    inv_for_store = loaded['inventory'][loaded['inventory']['店舗名'] == selected_store]
    inv_dates = sorted(inv_for_store['棚卸日_d'].dropna().unique(), reverse=True)

    if len(inv_dates) == 0:
        st.warning(f"⚠️ {selected_store} の棚卸データがありません。")
    else:
        col_a, col_b, col_c = st.columns([1.5, 1.5, 2])
        with col_a:
            eval_target_date = st.selectbox(
                "📅 評価対象の棚卸日",
                inv_dates,
                format_func=lambda d: d.strftime('%Y-%m-%d') if d else '',
                key='eval_target_date',
            )
        with col_b:
            st.markdown(f"**🏪 対象店舗**  \n{selected_store}")
            st.caption("（上部の店舗カードで切替）")
        with col_c:
            prev_dates = [d for d in inv_dates if d < eval_target_date]
            if prev_dates:
                prev_date_show = max(prev_dates)
                period_start = prev_date_show + datetime.timedelta(days=1)
                st.markdown(f"**📋 前回棚卸日**  \n{prev_date_show.strftime('%Y-%m-%d')}")
                st.caption(f"集計期間：{period_start} 〜 {eval_target_date}")
            else:
                st.markdown("**📋 前回棚卸日**  \n_なし_")
                st.caption("論理在庫＝0 として表示（前回棚卸が必要）")

        st.markdown("---")

        # ---- 計算実行 ----
        df_eval = calculate_inventory_evaluation(
            selected_store, eval_target_date, loaded,
            base_days=params['base_days'],
            yield_fusoku=params['yield_fusoku'],
            yield_kasoku=params['yield_kasoku'],
        )

        if len(df_eval) == 0:
            st.warning("評価対象の原料がありません（マスタを確認してください）")
        else:
            # ====== セクション1：詳細評価 ======
            st.markdown("### 📋 セクション1：今回棚卸の詳細評価")

            # ---- 上段：A/B/C 3グループ階層表示（2026/5/15 / 2026/5/18 改定） ----
            # A: 棚卸データ全体の規模感（論理＝評価対象の総数 / 実在庫 / 実在庫なし）
            #    業務側「論理在庫」=評価対象の総数。差 = 実在庫 - 評価対象 = -実在庫なし件数
            # B: 実在庫>0 のアイテムを「不動 / アクティブ」に分類（合計＝実在庫件数）
            # C: アクティブ在庫の中身（過剰 / 不足、内訳の過剰α）
            n_a_logical = len(df_eval)  # 評価対象の総数（2026/5/18 業務側ラベルに合わせて変更）
            n_a_actual = int((df_eval['実在庫'] > 0).sum())
            n_a_diff = n_a_actual - n_a_logical  # マイナスで「実在庫なし件数」に等しい
            n_a_no_actual = int((df_eval['分類'] == '実在庫なし').sum())
            # 真のカウント漏れ候補：論理在庫値>0（あるはず）かつ 実在庫=0（無い）
            n_a_true_missing = int(((df_eval['論理在庫'] > 0) & (df_eval['実在庫'] <= 0)).sum())

            # B：実在庫>0 のみが対象。 n_b_inactive + n_b_active == n_a_actual を保証
            n_b_inactive = int((df_eval['分類'] == '不動').sum())
            n_b_active = int(df_eval['分類'].isin(['過剰', '過剰α', '不足']).sum())

            n_c_alpha = int((df_eval['分類'] == '過剰α').sum())
            n_c_over = int(((df_eval['分類'] == '過剰') | (df_eval['分類'] == '過剰α')).sum())
            n_c_short = int((df_eval['分類'] == '不足').sum())

            # HTML/CSS でカード風レイアウト
            def _row(label, value, indent=0, sub=None):
                ind = indent * 18
                sub_html = f'<span style="font-size:0.8em;color:#888;margin-left:6px;">{sub}</span>' if sub else ''
                return f'''
                <div style="display:flex;justify-content:space-between;align-items:baseline;
                            padding:6px 0;padding-left:{ind}px;border-bottom:1px solid #f0f0f0;">
                  <span style="color:#444;font-size:0.95em;">{label}{sub_html}</span>
                  <span style="font-size:1.35em;font-weight:600;color:#222;">{value} <span style="font-size:0.65em;color:#888;font-weight:400;">件</span></span>
                </div>
                '''

            def _card(title, color, rows_html):
                return f'''
                <div style="border:1px solid #ddd;border-left:4px solid {color};
                            border-radius:6px;padding:14px 16px;background:#fcfcfc;height:100%;">
                  <div style="font-weight:600;color:#333;margin-bottom:10px;font-size:0.95em;">{title}</div>
                  {rows_html}
                </div>
                '''

            col_a, col_b, col_c = st.columns(3)
            with col_a:
                rows = (
                    _row("論理在庫", f"{n_a_logical}", sub="評価対象の総数")
                    + _row("実在庫", f"{n_a_actual}", sub=f"差 {n_a_diff:+d}")
                    + _row("実在庫なし", f"{n_a_no_actual}")
                    + _row("うちカウント漏れ可能性", f"{n_a_true_missing}", indent=1,
                           sub="論理値あり×棚卸0")
                )
                st.markdown(_card("🔍 A. 棚卸の規模感（カウント漏れ検出）", "#4a90e2", rows), unsafe_allow_html=True)
            with col_b:
                rows = _row("不動在庫", f"{n_b_inactive}", indent=1) + _row("アクティブ", f"{n_b_active}", indent=1)
                st.markdown(_card("📊 B. 実棚アイテムの在庫分類", "#7cb342", rows), unsafe_allow_html=True)
            with col_c:
                rows = (_row("過剰", f"{n_c_over}", indent=2, sub=f"内 過剰α {n_c_alpha}")
                        + _row("不足", f"{n_c_short}", indent=2))
                st.markdown(_card("⚡ C. アクティブ在庫の実態", "#fb8c00", rows), unsafe_allow_html=True)

            st.caption(
                f"※ 評価対象は **棚卸データに登場した原料のみ**（前回または今回の棚卸でカウントあり）"
                f"／対象区分=対象外 を除外、計 {len(df_eval)} 件"
            )

            st.markdown("---")

            # ---- 下段：乖離評価 × 在庫分類 クロス集計 ----
            st.markdown("### 🎯 乖離評価 × 在庫分類")

            eval_order = ['◎', '○', '△', '×']
            # 2026/5/18：'実在庫なし' を追加（A セクションの「実在庫なし」と整合）
            class_order = ['不動', '過剰', '過剰α', '不足', '実在庫なし']

            cross = pd.crosstab(df_eval['評価'], df_eval['分類'])
            cross = cross.reindex(index=eval_order, columns=class_order, fill_value=0)
            cross['合計'] = cross.sum(axis=1)
            cross.loc['合計'] = cross.sum(axis=0)
            cross = cross[['合計'] + class_order]

            eval_labels = {
                '◎': '◎ (±5)',
                '○': '○ (±20)',
                '△': '△ (±30)',
                '×': '× (>30)',
                '合計': '合計',
            }
            cross.index = [eval_labels.get(v, v) for v in cross.index]
            cross.index.name = '評価'

            st.dataframe(
                cross,
                use_container_width=True,
                column_config={
                    c: st.column_config.NumberColumn(c, format='%d', width=80)
                    for c in cross.columns
                },
            )

            st.caption(
                "◎ ±5以内 / ○ ±20以内 / △ ±30以内 / × ±30超 ─ 行=評価、列=在庫分類、値=件数"
            )


# ========== タブ7：原料ピックアップ（2026/5/15 実装） ==========
# 棚卸評価タブで集計された ◎○△× × 在庫分類に対して、
# 具体的にどの原料が該当するかを一覧で確認するタブ。
# 棚卸評価タブと同じ「店舗 × 棚卸日」を参照する（連動表示）。
with tab7:
    st.subheader("🔍 原料ピックアップ")

    # ---- 連動元（棚卸評価タブ）の選択を参照 ----
    # 将来「独立させたい」要望が出た場合は、ここを selectbox に切り替えればよい
    pickup_store = selected_store
    pickup_target_date = st.session_state.get('eval_target_date')

    pickup_inv_for_store = loaded['inventory'][loaded['inventory']['店舗名'] == pickup_store]
    pickup_inv_dates = sorted(pickup_inv_for_store['棚卸日_d'].dropna().unique(), reverse=True)

    if len(pickup_inv_dates) == 0:
        st.warning(f"⚠️ {pickup_store} の棚卸データがありません。")
    else:
        # eval_target_date が未設定 or 不一致なら最新日にフォールバック
        if pickup_target_date is None or pickup_target_date not in pickup_inv_dates:
            pickup_target_date = pickup_inv_dates[0]

        # ---- 上部UI ----
        col_a, col_b, col_c = st.columns([1.5, 1.5, 2.5])
        with col_a:
            st.markdown(f"**🏪 店舗**  \n{pickup_store}")
        with col_b:
            st.markdown(f"**📅 棚卸日**  \n{pickup_target_date.strftime('%Y-%m-%d')}")
        with col_c:
            st.caption(
                "📊 棚卸評価タブと同じ店舗・棚卸日を表示中。"
                "店舗は上部の店舗カードで、棚卸日は『棚卸評価』タブで変更できます。"
            )

        # ---- 計算実行（棚卸評価タブと同じ関数） ----
        df_pickup = calculate_inventory_evaluation(
            pickup_store, pickup_target_date, loaded,
            base_days=params['base_days'],
            yield_fusoku=params['yield_fusoku'],
            yield_kasoku=params['yield_kasoku'],
        )

        if len(df_pickup) == 0:
            st.warning("評価対象の原料がありません（棚卸データを確認してください）")
        else:
            st.markdown("---")

            # ---- フィルタ ----
            eval_all = ['◎', '○', '△', '×']
            class_all = ['不動', '過剰', '過剰α', '不足', '実在庫なし']

            # クイックボタン（全選択 / 全解除）
            bcol1, bcol2, _ = st.columns([1, 1, 4])
            if bcol1.button("☑️ すべて選択", key='pickup_select_all', use_container_width=True):
                for v in eval_all:
                    st.session_state[f'pickup_eval_{v}'] = True
                for v in class_all:
                    st.session_state[f'pickup_class_{v}'] = True
                st.rerun()
            if bcol2.button("☐ すべて解除", key='pickup_clear_all', use_container_width=True):
                for v in eval_all:
                    st.session_state[f'pickup_eval_{v}'] = False
                for v in class_all:
                    st.session_state[f'pickup_class_{v}'] = False
                st.rerun()

            # 評価チェックボックス（横並び4つ）
            st.markdown("**評価フィルタ**")
            ec1, ec2, ec3, ec4 = st.columns(4)
            sel_eval = []
            for v, col in zip(eval_all, [ec1, ec2, ec3, ec4]):
                # デフォルト全選択（初回のみ true）
                key = f'pickup_eval_{v}'
                if key not in st.session_state:
                    st.session_state[key] = True
                if col.checkbox(v, key=key):
                    sel_eval.append(v)

            # 分類チェックボックス（横並び4つ）
            st.markdown("**分類フィルタ**")
            cc1, cc2, cc3, cc4, cc5 = st.columns(5)
            sel_class = []
            for v, col in zip(class_all, [cc1, cc2, cc3, cc4, cc5]):
                key = f'pickup_class_{v}'
                if key not in st.session_state:
                    st.session_state[key] = True
                if col.checkbox(v, key=key):
                    sel_class.append(v)

            # ---- フィルタ適用 ----
            df_filtered = df_pickup[
                df_pickup['評価'].isin(sel_eval) & df_pickup['分類'].isin(sel_class)
            ].reset_index(drop=True)

            # ---- 件数表示 ----
            st.markdown(
                f"### 🎯 絞り込み結果：**{len(df_filtered)} 件** / 全 {len(df_pickup)} 件"
            )

            if len(df_filtered) == 0:
                st.info("条件に該当する原料はありません。フィルタを見直してください。")
            else:
                # ---- 表示用 DataFrame（列順を整理。原料名を先頭にして固定列に） ----
                show_cols = [
                    '原料名', '原料JAN', '原料区分', '対象区分',
                    '前回棚卸日', '前回棚卸数', '納品数', '使用量',
                    '論理在庫', '実在庫', '差', '|差|',
                    '評価', '分類', '1日使用量', '安全在庫',
                ]
                show_cols = [c for c in show_cols if c in df_filtered.columns]
                df_show = df_filtered[show_cols]

                # タスクG-2：sticky HTML表へ置換（原料名固定・文字大・差/評価を色強調）
                def _eval_cell_cls(col, v):
                    if col == '差' and isinstance(v, (int, float, np.integer, np.floating)) and not pd.isna(v):
                        return 'neg' if v < 0 else ''
                    if col == '評価':
                        if v == '×':
                            return 'neg'
                        if v == '◎':
                            return 'pos'
                    return ''

                render_html_table(
                    df_show,
                    scope="htbl-eval",
                    pin_cols=['原料名'],
                    pin_widths={'原料名': 220},
                    col_labels={
                        '前回棚卸数': '前回棚卸', '納品数': '納品', '論理在庫': '論理',
                        '実在庫': '実', '対象区分': '対象', '1日使用量': '1日使用',
                    },
                    col_formats={
                        '前回棚卸数': '%.1f', '納品数': '%.1f', '使用量': '%.1f',
                        '論理在庫': '%.1f', '実在庫': '%.1f', '差': '%+.1f', '|差|': '%.1f',
                        '1日使用量': '%.2f', '安全在庫': '%.1f',
                    },
                    col_align={
                        '原料JAN': 'left', '原料区分': 'left', '対象区分': 'center',
                        '前回棚卸日': 'center', '評価': 'center', '分類': 'center',
                    },
                    cell_class_func=_eval_cell_cls,
                    max_height=700,
                )
                st.caption("💡 原料名は左端固定・見出しは上端固定（横/縦スクロールしても消えません）。差マイナスと評価×は赤強調。")

                # ---- CSV ダウンロード ----
                import io as _io
                csv_buf = _io.StringIO()
                df_show.to_csv(csv_buf, index=False, encoding='utf-8-sig')
                ts = datetime.datetime.now().strftime('%Y%m%d_%H%M%S')
                fname = f"棚卸評価_{pickup_store}_{pickup_target_date.strftime('%Y%m%d')}_{ts}.csv"
                st.download_button(
                    label="📥 絞り込み結果を CSV でダウンロード",
                    data=csv_buf.getvalue().encode('utf-8-sig'),
                    file_name=fname,
                    mime='text/csv',
                )


# ========== タブ8：📦 エリア在庫（2026/5/18 追加） ==========
# エリア（店舗グルーピング）内の店舗を横断して、特定原料の在庫状況を確認し
# 移動候補を提示するタブ。
# 構成：
#   上部UI（エリア・原料・基準日選択）         ← Phase 3B
#   メイン表（店舗×日付、論理在庫＋予測在庫）  ← Phase 3C
#   サジェスト（過剰→不足の移動候補）          ← Phase 3D
with tab8:
    st.subheader("📦 エリア在庫")
    st.caption(
        "※ 在庫推移は『計画通りに進んだ場合の予測値』です。"
        "📉計画推移・📋実績推移と同じ計算ロジックを使用。"
        "棚卸評価タブの『論理在庫』とは目的が異なるため、数字が違うことがあります。"
    )

    # ---- 店舗グルーピング設定の取得 ----
    area_groups_data = load_store_groups()
    area_groups = area_groups_data.get('groups', [])

    if not area_groups:
        st.warning(
            "⚠️ 店舗グルーピングが未設定です。"
            "**⚙️設定タブ** で店舗グルーピングを設定してください。"
        )
    else:
        # ---- 上部UI（2026/5/19 改定）：3段構造 ----
        # 1段目：エリア（selectbox）／ 基準日（date_input）
        # 2段目：原料区分（ボタン群、画面幅で折り返し）
        # 3段目：原料（ボタン群、画面幅で折り返し）
        # selectbox のポップアップで画面占領しないよう、タグ風ボタンに変更

        # material から対象区分=対象外を除外、区分ごとに整理
        mat_df = loaded['material'].copy()
        mat_df['原料JAN'] = mat_df['原料JAN'].astype(str).str.strip()
        if '対象区分' in mat_df.columns:
            mat_df = mat_df[mat_df['対象区分'] != '対象外'].copy()
        mat_df = mat_df.drop_duplicates('原料JAN').reset_index(drop=True)
        mat_df['原料No_int'] = pd.to_numeric(mat_df.get('原料No'), errors='coerce')

        # 業務的並び順の原料区分リスト（共通関数）
        sorted_kubuns = get_sorted_material_categories(loaded['material'], exclude_target_gai=True)
        kubuns_with_items = [k for k in sorted_kubuns if (mat_df['原料区分'] == k).any()]

        # --- 1段目：エリア / 基準日 ---
        col_area, col_date = st.columns([2.5, 1.0])
        with col_area:
            area_names = [g['name'] for g in area_groups]
            sel_area_name = st.selectbox(
                "🏘️ エリア",
                area_names,
                key='area_inv_area',
                help="⚙️設定タブの『店舗グルーピング』で設定したエリアから選択",
            )
            sel_area = next((g for g in area_groups if g['name'] == sel_area_name), None)
            area_stores = sel_area.get('stores', []) if sel_area else []
            st.caption(f"{len(area_stores)}店舗：{', '.join(area_stores) if area_stores else '所属なし'}")
        with col_date:
            today = datetime.date.today()
            inv_dates = loaded['inventory']['棚卸日_d'].dropna()
            plan_dates = loaded['plan']['日付_d'].dropna() if 'plan' in loaded else pd.Series([], dtype='object')
            min_date = inv_dates.min() if len(inv_dates) > 0 else today - datetime.timedelta(days=30)
            max_date = plan_dates.max() if len(plan_dates) > 0 else today + datetime.timedelta(days=30)
            default_date = today if min_date <= today <= max_date else max_date
            sel_base_date = st.date_input(
                "📅 基準日",
                value=default_date,
                min_value=min_date,
                max_value=max_date,
                key='area_inv_base_date',
                help="この日を起点に、当日〜+4日の在庫推移と1日使用量を計算",
            )

        # --- 2段目：原料区分（ボタン群、画面幅で折り返し） ---
        # session_state を初期化（初回 or 値が消えた場合）
        if 'area_inv_kubun' not in st.session_state or st.session_state['area_inv_kubun'] not in kubuns_with_items:
            st.session_state['area_inv_kubun'] = kubuns_with_items[0] if kubuns_with_items else None
        # ボタン群（21個）の DOM 描画が重かったため radio に変更（DOMノード1個）。
        sel_kubun = st.radio(
            "🏷️ 原料区分",
            kubuns_with_items,
            horizontal=True,
            key='area_inv_kubun',
            help="業務的並び順（ご飯・サーモン・マグロ…包材末尾）。タップで切替",
        )

        # --- 3段目：原料（selectbox、区分内の原料、原料No順、2026/5/19 ハイブリッド案A'） ---
        mat_in_kubun = mat_df[mat_df['原料区分'] == sel_kubun].sort_values(
            ['原料No_int', '原料名'], na_position='last'
        ).reset_index(drop=True)
        mat_options = list(mat_in_kubun['原料JAN'])
        mat_labels = {row['原料JAN']: row['原料名'] for _, row in mat_in_kubun.iterrows()}

        # ---- 関連グループ N>=2 のラベル末尾に「 [関連N件]」を付与（2026/5/20）----
        # CD違い同一原料の手動グループ定義（data/material_groups.csv）に基づき、
        # radio 表示だけを書き換える。選択値（mat_options = 原料JAN）はそのまま、
        # 既存 mat_labels も純粋な原料名のまま保持（タイトル等の他参照を壊さない）。
        # キャッシュ取得を区分内件数ぶん繰り返さないよう、groups_df は1度だけ取得。
        _mg_df = load_material_groups()
        mat_labels_radio = {}
        for _j in mat_options:
            _base = mat_labels.get(_j, _j)
            _related = get_related_material_cds(_j, groups_df=_mg_df)
            if len(_related) >= 2:
                mat_labels_radio[_j] = f"{_base} [関連{len(_related)}件]"
            else:
                mat_labels_radio[_j] = _base

        # 区分変更時に「現在選択中の原料」が新区分に含まれない場合、先頭にリセット
        if 'area_inv_material' not in st.session_state or st.session_state['area_inv_material'] not in mat_options:
            st.session_state['area_inv_material'] = mat_options[0] if mat_options else None
        # radio に統一（2026/5/19）：selectbox はタブレットでソフトキーボードが出てしまうため。
        # radio は DOM ノード1個なので、159件あっても描画は軽い（包材系の縦スクロールで対応）。
        sel_material_jan = st.radio(
            f"📦 原料（区分内 {len(mat_options)} 件）",
            mat_options,
            format_func=lambda j: mat_labels_radio.get(j, mat_labels.get(j, j)),
            key='area_inv_material',
            help="区分内の原料から選択（タップで切替、159件の場合は縦スクロール）",
        )

        st.markdown("---")

        # ---- メイン表：エリア内 9 店舗 × 基準日±4日 の在庫推移 ----
        if not area_stores:
            st.warning("このエリアには店舗が割り当てられていません。⚙️設定タブで設定してください。")
        else:
            with st.spinner(f"{len(area_stores)} 店舗の在庫推移を計算中..."):
                df_area = get_area_inventory_data(
                    area_stores,
                    sel_material_jan,
                    sel_base_date,
                    base_days=params['base_days'],
                    yield_fusoku=params['yield_fusoku'],
                    yield_kasoku=params['yield_kasoku'],
                    target_date=params['target_date'],
                )

            # 余裕日数の少ない順（昇順）、NaN は最下部
            # → 危険な店舗が上に来て移動検討のフォーカスがしやすい
            df_area = df_area.sort_values(
                '余裕日数', ascending=True, na_position='last'
            ).reset_index(drop=True)

            st.markdown(
                f"### 📊 在庫推移：**{mat_labels.get(sel_material_jan, '')}** "
                f"<span style='color:#888;font-size:0.7em'>"
                f"／ {sel_area_name}（{len(area_stores)}店舗）／ 基準日 {sel_base_date}</span>",
                unsafe_allow_html=True,
            )

            st.dataframe(
                df_area,
                use_container_width=True,
                hide_index=True,
                height=min(560, 60 + len(df_area) * 38),
                column_config={
                    '店舗': st.column_config.TextColumn('店舗', width=140, pinned=True),
                    '最新棚卸日': st.column_config.DateColumn('最新棚卸日', width=110),
                    '実棚卸数': st.column_config.NumberColumn('実棚卸', format='%.1f', width=80),
                    '論理在庫': st.column_config.NumberColumn(
                        '論理在庫（基準日）', format='%.1f', width=120,
                        help='基準日時点の在庫予測値（calculate_flow と同じ）',
                    ),
                    '当日': st.column_config.NumberColumn('当日', format='%.1f', width=80),
                    '+1日': st.column_config.NumberColumn('+1日', format='%.1f', width=70),
                    '+2日': st.column_config.NumberColumn('+2日', format='%.1f', width=70),
                    '+3日': st.column_config.NumberColumn('+3日', format='%.1f', width=70),
                    '+4日': st.column_config.NumberColumn('+4日', format='%.1f', width=70),
                    '1日使用量': st.column_config.NumberColumn('1日使用', format='%.2f', width=80),
                    '余裕日数': st.column_config.NumberColumn(
                        '余裕日数', format='%.1f日', width=90,
                        help='基準日の論理在庫 ÷ 1日使用量（⓪余裕日数 と同じ）',
                    ),
                    'ステータス': st.column_config.TextColumn('ステータス', width=130),
                },
            )

            st.caption(
                "💡 列ヘッダクリックでソート可能。"
                "「当日」と「論理在庫」は同じ値（基準日の在庫予測）。"
            )

            # ---- 簡易サマリー ----
            st.markdown("---")
            st.markdown("### 📋 エリアサマリー")

            n_danger = int((df_area['ステータス'] == '🚨 危険').sum())
            n_caution = int((df_area['ステータス'] == '⚠️ 注意').sum())
            n_safe = int((df_area['ステータス'] == '✅ 安全').sum())
            n_no_use = int((df_area['ステータス'] == '— 使用予定なし').sum())

            logical_sum = df_area['論理在庫'].dropna().sum()
            inv_sum = df_area['実棚卸数'].dropna().sum()

            sc1, sc2, sc3, sc4, sc5 = st.columns(5)
            sc1.metric('エリア合計（論理在庫）', f'{logical_sum:,.1f}')
            sc2.metric('🚨 危険（不足候補）', f'{n_danger} 店舗')
            sc3.metric('⚠️ 注意', f'{n_caution} 店舗')
            sc4.metric('✅ 安全', f'{n_safe} 店舗', help='余裕日数 > 4日。過剰候補としてサジェスト対象')
            sc5.metric('— 使用予定なし', f'{n_no_use} 店舗')

            if n_danger > 0 and n_safe > 0:
                st.info(
                    f"💡 危険な店舗 **{n_danger}** 件、過剰候補（安全）**{n_safe}** 件あります。"
                    "**フェーズ3D** で具体的な移動候補ペアと推奨移動量をサジェストする予定です。"
                )
            elif n_danger > 0:
                st.warning(
                    f"⚠️ 危険な店舗が **{n_danger}** 件あります。"
                    "ただし同エリア内に過剰候補（安全）がないため、エリア内移動では解決できません。発注検討が必要。"
                )
            elif n_safe == len(df_area):
                st.success("✅ エリア内のすべての店舗が安全域です。")

            # ---- サジェスト：過剰候補 → 不足候補 の移動候補（Phase 3D）----
            st.markdown("---")
            st.markdown(f"### 💡 移動候補サジェスト")
            st.caption(
                f"目標：両店舗の余裕日数を {TARGET_MARGIN_DAYS} 日に近づける。"
                "対象は **🚨 危険（余裕<2日）→ ✅ 安全（余裕>4日）** のみ。"
                "⚠️ 注意（2-4日）と「— 使用予定なし」は対象外。"
            )

            sg_df, sg_info, sg_unfulfilled = calculate_move_suggestions(df_area)

            if sg_info:
                # 不足候補なし or 過剰候補なし or 余剰不足
                if '✅' in sg_info:
                    st.success(sg_info)
                else:
                    st.warning(sg_info)
            elif len(sg_df) == 0:
                st.info("提案できる移動候補がありません。")
            else:
                st.dataframe(
                    sg_df,
                    use_container_width=True,
                    hide_index=True,
                    column_config={
                        '移動元': st.column_config.TextColumn('移動元', width=140),
                        '元 余裕（前→後）': st.column_config.TextColumn('元 余裕（前→後）', width=160),
                        '推奨移動量': st.column_config.NumberColumn(
                            '推奨移動量', format='%.1f', width=110,
                            help='移動元の余剰を移動先に分配する量。両者の余裕日数が目標に近づく',
                        ),
                        '移動先': st.column_config.TextColumn('移動先', width=140),
                        '先 余裕（前→後）': st.column_config.TextColumn('先 余裕（前→後）', width=160),
                    },
                )
                st.caption(
                    "💡 1行 = 1ペアの移動提案。"
                    "「前→後」は移動を実行した場合の余裕日数の変化（推定値）。"
                    "あくまで参考。最終判断は人間が行ってください。"
                )

            if sg_unfulfilled:
                st.warning(sg_unfulfilled)


# ========== タブ9：設定（管理対象原料の絞り込み） ==========
# 「管理する原料」を画面上で選択し、保存できるタブ。
# 設定ファイルに書き出され、次回起動時から全タブで適用される。
#
# 仕様：
# - 全原料一覧から、管理対象にしたい原料を multiselect で選択
# - 「全店舗共通」「この店舗のみ」を選んで保存
# - 「フィルタ解除」で設定ファイル削除（=全原料表示に戻る）
# - 原料区分・対象区分での一括選択ヘルパー
with tab9:
    st.subheader("⚙️ 設定")
    
    # 現在の編集対象店舗を明示
    st.markdown(f"""
    <div style='
        background: #e3f2fd;
        border-left: 4px solid #1565c0;
        padding: 8px 14px;
        border-radius: 4px;
        margin-bottom: 14px;
        font-size: 0.95rem;
    '>
        🏪 編集対象店舗：<b>{selected_store}</b>
        <span style='font-size: 0.85rem; color: #555;'>　（店舗を切り替えるには上部のボタンから）</span>
    </div>
    """, unsafe_allow_html=True)
    
    # ============================================================
    # チューニング設定（店舗ごと）
    # ============================================================
    st.markdown("### 🎚️ チューニング設定")
    st.caption("コントローラーが現場の実態に合わせて調整するパラメータ。店舗ごとに設定できます。")
    
    cols2 = st.columns(4)
    with cols2[0]:
        params['base_days'] = st.number_input(
            "安全在庫の基準日数",
            min_value=1, max_value=14,
            value=params['base_days'], step=1,
            help="安全在庫を計算するときに「何日分の使用量を確保するか」",
        )
    with cols2[1]:
        params['yield_fusoku'] = st.number_input(
            "歩留(不測)",
            min_value=0.1, max_value=1.0,
            value=params['yield_fusoku'], step=0.05, format="%.2f",
            help="ロスが計量できない原料の歩留率",
        )
    with cols2[2]:
        params['yield_kasoku'] = st.number_input(
            "歩留(可測)",
            min_value=0.1, max_value=1.0,
            value=params['yield_kasoku'], step=0.05, format="%.2f",
            help="ロスが計量できる原料の歩留率",
        )
    with cols2[3]:
        params['target_date'] = st.date_input(
            "実績指定日",
            value=params['target_date'],
            min_value=actual_min,
            max_value=actual_max,
            help="この日まで実績、それ以降は計画で再計算",
        )
    
    st.session_state.store_params[selected_store] = params
    st.caption("💡 値を変更すると自動的に全タブの計算に反映されます")
    
    st.divider()
    
    # ============================================================
    # 管理対象原料の絞り込み
    # ============================================================
    st.markdown("### 🎯 管理対象原料の絞り込み")
    st.caption(
        "現場で実際に管理している原料だけに絞り込んで表示します。"
        "サマリー・在庫推移・ズレ補正など全タブに適用されます。"
    )
    
    # 現在の設定状況を表示
    current_cfg = load_managed_jans(selected_store)
    if current_cfg and current_cfg.get('jans'):
        scope_label = current_cfg.get('store', '共通')
        n_now = len(current_cfg['jans'])
        st.success(
            f"✅ 現在の設定:**{n_now}原料**を管理対象としています(適用範囲:{scope_label})"
        )
    else:
        st.info("ℹ️ 現在は**全原料**を表示しています(フィルタなし)")
    
    # ---- 全原料一覧を取得 ----
    if 'material' in loaded:
        mat_df_all = loaded['material'].copy()
        mat_df_all['原料JAN'] = mat_df_all['原料JAN'].astype(str).str.strip()
        mat_df_all['原料名'] = mat_df_all['原料名'].astype(str).str.strip()
    else:
        st.warning("原料マスタが読み込まれていません")
        mat_df_all = pd.DataFrame()
    
    if len(mat_df_all) > 0:
        # ---- 対象区分=「対象外」を自動除外 ----
        n_taishogai = (mat_df_all['対象区分'] == '対象外').sum()
        mat_df = mat_df_all[mat_df_all['対象区分'] != '対象外'].copy()
        
        st.warning(
            f"🚫 **「対象区分=対象外」の {n_taishogai} 原料は候補から除外中**"
            f"(管理対象として保存できません。残り候補:{len(mat_df)} 原料)"
        )
        
        st.divider()
        
        # ============================================================
