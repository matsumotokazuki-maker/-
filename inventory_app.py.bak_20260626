        "空欄＝未割り当て。1店舗1グループのみ（複数所属は不可）。"
    )
    assignment_df = pd.DataFrame({
        '店舗': stores_to_show,
        'グループ': [store_to_group.get(s, '') for s in stores_to_show],
    })

    edited = st.data_editor(
        assignment_df,
        num_rows='fixed',
