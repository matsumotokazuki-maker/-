        _ok = st.session_state.get('_import_ok', False)
        (st.success if _ok else st.error)(
            "✅ 取込が完了しました" if _ok else "❌ 取込でエラーがありました（下のログを確認）"
        )
        with st.expander("📜 実行ログ", expanded=not _ok):
            st.code(st.session_state['_import_log'][-6000:], language='text')
        if st.button("ログを消す", key='_clear_import_log'):
            st.session_state.pop('_import_log', None)
            st.session_state.pop('_import_ok', None)
            st.rerun()

    # 取込種別のガイド（業務プロセスとの対応）
    st.markdown("""
<div style='background:#f0f6ff;border-left:4px solid #2e5496;padding:8px 12px;border-radius:4px;font-size:0.9rem;margin:6px 0 12px 0;'>
<b>置くファイルで種別が自動判定されます</b>（<code>business_system_export\\</code> に配置）<br>
　🗓️ <b>A 全取込（フル）</b>：月初・棚卸翌日。基礎7ファイル（マスタ・計画・実績・棚卸）<br>
　📅 <b>B 日次差分</b>：毎日。製造数＋実納品数（YYYYMMDD付）<br>
　🔧 <b>C 一部取込</b>：随時。納品予定数の差し替え／棚卸修正／マスタ更新
</div>
""", unsafe_allow_html=True)

    # 配置状況の見える化
    _raw_files = _list_csv_brief(RAW_EXPORT_DIR)
    _ir_files = _list_csv_brief(INPUT_RAW_DIR)
    _c1, _c2 = st.columns(2)
    with _c1:
        st.caption(f"① business_system_export（生ファイル）：{len(_raw_files)}件")
        st.code('\n'.join(_raw_files) if _raw_files else '（空）', language='text')
    with _c2:
        st.caption(f"② input_raw（整形済み・update対象）：{len(_ir_files)}件")
        st.code('\n'.join(_ir_files) if _ir_files else '（空）', language='text')

    st.markdown("**取込を実行**（① 整形 → ② 取込 の順。通常は『整形＋取込』を押すだけ）")
    _b1, _b2, _b3 = st.columns(3)

    def _finish(ok, log, reload_after):
        st.session_state['_import_log'] = log
        st.session_state['_import_ok'] = ok
        if ok and reload_after:
            rok, rmsg = reload_pkl_into_session()
            st.session_state['_import_ok'] = rok
            st.session_state['_import_log'] += f"\n\n[pkl再読込] {rmsg}"
        st.rerun()

    with _b1:
        if st.button("① 整形（convert_raw）", use_container_width=True, key='_btn_convert'):
            with st.spinner("整形中（convert_raw_to_app.py）..."):
                ok, log = run_pipeline_script('convert_raw_to_app.py')
            _finish(ok, log, reload_after=False)
    with _b2:
        if st.button("② 取込（update_data）", use_container_width=True, key='_btn_update'):
            with st.spinner("取込中（update_data.py）..."):
                _moved, _qd = auto_quarantine_fullload_for_diff()
                ok, log = run_pipeline_script('update_data.py')
            if _moved:
                log = (f"[自動退避] 差分日のため、残置していた日付なしフルロード{len(_moved)}ファイルを "
                       f"{_qd}\\ へ退避しました（混在エラー回避・可逆）:\n  " + ", ".join(_moved)
                       + "\n\n========== update_data ==========\n") + log
            _finish(ok, log, reload_after=True)
    with _b3:
        if st.button("🔄 整形＋取込（推奨）", type='primary', use_container_width=True, key='_btn_both'):
            with st.spinner("整形→取込を実行中..."):
                ok1, log1 = run_pipeline_script('convert_raw_to_app.py')
                if ok1:
                    # 整形後・取込前に、差分日の残置フルロード7ファイルを自動退避（混在エラー回避）
                    _moved, _qd = auto_quarantine_fullload_for_diff()
                    ok2, log2 = run_pipeline_script('update_data.py')
                    _q = (f"[自動退避] 差分日のため、残置していた日付なしフルロード{len(_moved)}ファイルを "
                          f"{_qd}\\ へ退避しました（混在エラー回避・可逆）:\n  " + ", ".join(_moved) + "\n\n") if _moved else ""
                    _finish(ok2, log1 + "\n\n========== update_data ==========\n" + _q + log2, reload_after=True)
                else:
                    _finish(False, log1 + "\n\n[中止] 整形でエラーのため取込はスキップしました。", reload_after=False)

    # 従来ルート（変換済み7CSVの直接アップロード＝全置換）を上級者向けに残す
    with st.expander("（上級）変換済み7CSVを直接アップロードして全置換", expanded=False):
        st.caption("※ convert済みの正しい列構成のCSVのみ。生ファイルは不可（KeyErrorになる）。通常は上の正規ルートを使う。")
        uploaded_files_reload = st.file_uploader(
            "7つのCSVファイル（順不同・複数選択可）",
            type=['csv'],
            accept_multiple_files=True,
            key='uploader_reload',
        )
        if uploaded_files_reload:
            st.info(f"📁 {len(uploaded_files_reload)} ファイルが選択されました")
            if st.button("📥 直接全置換で取込", key='reload_btn'):
                with st.spinner("読み込み中..."):
                    if process_uploaded_files(uploaded_files_reload):
                        st.session_state.data_version = st.session_state.get('data_version', 0) + 1
                        st.success("✅ 再読込完了")
                        st.rerun()

    st.divider()

    # ============================================================
    # 📡 データモニタリング（異常検知）Step1 — 2026-06-08
    # ============================================================
    st.markdown("### 📡 データモニタリング（異常検知）")
    st.caption("全店横断で『緊急に動くべきケース』と『データの異常』を監視します。検知と“振り先”のみで、対策（増やせ／減らせ）は出しません。利用者＝本部・設計視点。")

    _dm_today = datetime.date.today()
    _dq = _dm_data_quality(_dm_today)

    # ---- 📊 全体サマリー（担当別）----
    st.markdown("#### 📊 全体サマリー（担当別）")
    _res0 = st.session_state.get('_dm_result')
    _a_done = _res0 is not None and hasattr(_res0, 'empty') and not _res0.empty
    if _a_done:
        if '棚卸opening' not in _res0.columns:
            _res0['棚卸opening'] = True
        _mg0 = _res0[_res0['棚卸opening']]
        _dp0 = _mg0['計画余裕'] < 2
        _da0 = _mg0['実績余裕'] < 2
        _n1 = int((_dp0 & _da0).sum())
        _n2 = int((_dp0 & ~_da0).sum())
        _n3 = int((~_dp0 & _da0).sum())
        _nundev = int((((_res0['計画余裕'] < 2) | (_res0['実績余裕'] < 2)) & (~_res0['棚卸opening'])).sum())
    else:
        _n1 = _n2 = _n3 = _nundev = None
    _nC = sum(n for _, n in _dq['dup'])
    _nD = _dq['kari']
    _nBwarn = sum(1 for _, _, days in _dq['fresh'] if days >= 3)
    _sg1, _sg2, _sg3, _sg4 = st.columns(4)
    _sg1.metric("🏪 現場（要現物確認・補正）", f"{_n1 + _n3}件" if _a_done else "—",
                help="A①最優先＋A③実態ズレ。現場が現物で確認・補正。未スキャンは『—』。")
    _sg2.metric("📐 齋藤さん（計画）", f"{_n2}件" if _a_done else "—",
                help="A②計画段＝計画作成で吸収すべき不足（上流）。")
    _sg3.metric("🗂 松本君（データ整備）", f"{_nC + _nD + (_nundev or 0)}件",
                help="C二重計上＋D仮JAN＋データ未整備（マスタ・データ設定）。")
    _sg4.metric("🔧 取込健全性", "⚠ 要確認" if _nBwarn else "✅ 正常",
                help="B：実績(製造/実納品)の取込鮮度。")
    if not _a_done:
        st.caption("※ A（在庫切れ緊急）と『データ未整備』は、下の『🔄 在庫切れ緊急を全店スキャン』を押すと集計され、ここに反映されます。")
    st.divider()

    # ---- B 取込の鮮度・欠損 ----
    st.markdown("**B｜取込の鮮度・欠損**　／　振り先：データ取得・取込プロセス")
    if _dq['fresh']:
        _bc = st.columns(len(_dq['fresh']))
        for i, (k, mx, days) in enumerate(_dq['fresh']):
            label = {'actual_prod': '製造実績', 'actual_del': '実納品'}.get(k, k)
            _bc[i].metric(f"{'🚨' if days >= 3 else '✅'} {label} 最終日", str(mx), f"{days}日前", delta_color="inverse")
    else:
        st.caption("（鮮度判定対象データなし）")

    # ---- C 二重計上（全列一致の重複）----
    st.markdown("**C｜二重計上（全列一致の重複）**　／　振り先：松本君（データ整備・ソース確認）")
    if _dq['dup']:
        for k, n in _dq['dup']:
            st.warning(f"⚠️ {k}：全列一致の重複 {n}件（計画・予定・棚卸系。calculate_flowが合算するため二重計上の恐れ）")
    else:
        st.success("✅ 計画・予定・棚卸系に全列一致の重複なし（ロード層dedupが機能）")

    # ---- D マスタ未登録（仮JAN 9992…）----
    st.markdown("**D｜マスタ未登録（仮JAN 9992…）**　／　振り先：松本君（マスタ整備・正本オーナー）")
    if _dq['kari_total']:
        st.warning(f"⚠️ 製造実績に仮JAN {_dq['kari']}商品（{_dq['kari_total']}行）。レシピ未登録で、その原料消費が在庫推移に乗りません（在庫計算の死角）。")
        with st.expander(f"該当の仮JAN商品を見る（最大50件）"):
            st.dataframe(_dq['kari_rows'], use_container_width=True, hide_index=True)
    else:
        st.success("✅ 仮JANなし")

    # ---- A 在庫切れ緊急（計画×実績の余裕日数2軸）----
    st.markdown("**A｜在庫切れ緊急（計画×実績の余裕日数2軸）**　／　振り先：①要 現場現物確認→手当て ②齋藤さん計画 ③現場・補正")
    st.caption("①計画も実績も危険＝最優先　②計画のみ危険＝計画段で吸収すべき（上流）　③実績のみ危険＝実態がズレ始め（現場・補正）。危険＝余裕<2日。")
    st.caption("※ ①②③はデータ上の“候補”です。特に①は、真に手当てすべきかを**現場が現物で確認して初めて確定**します（データだけで断定しない＝判断は人に残す）。B/C/D・データ未整備はデータだけで判定できる異常です。")
    if st.button("🔄 在庫切れ緊急を全店スキャン", key='_dm_scan'):
        with st.spinner("全店の計画/実績 余裕日数を計算中..."):
            st.session_state['_dm_result'] = _dm_scan_stockout(_dm_today)
            st.session_state['_dm_scanned_at'] = datetime.datetime.now().strftime('%Y-%m-%d %H:%M')
    _res = st.session_state.get('_dm_result')
    if _res is None:
        st.caption("※ ボタンを押すと全店の計画/実績 余裕日数を計算し ①②③ に分類します（重い処理のため手動実行）。粕屋CK等の計画なし拠点は対象外。")
    elif _res.empty:
        st.info("対象データなし、または計算可能な原料がありませんでした。")
    else:
        if '棚卸opening' not in _res.columns:
            _res['棚卸opening'] = True
        # データ未整備：棚卸opening無で危険判定＝在庫として管理されていない（真の在庫切れと分離）
        _danger_any = (_res['計画余裕'] < 2) | (_res['実績余裕'] < 2)
        _cat_d = _res[_danger_any & (~_res['棚卸opening'])]
        # 真の①②③ は opening 有り（在庫管理されている原料）に限定
        _mg = _res[_res['棚卸opening']]
        _dp = _mg['計画余裕'] < 2
        _da = _mg['実績余裕'] < 2
        _cat1 = _mg[_dp & _da]
        _cat2 = _mg[_dp & ~_da]
        _cat3 = _mg[~_dp & _da]
        _m1, _m2, _m3, _m4 = st.columns(4)
        _m1.metric("① 最優先・要現物確認", f"{len(_cat1)}件", help="計画も実績も危険。ただしデータ上の候補で、真に手当てすべきかは現場の現物確認で確定（判断は人）。")
        _m2.metric("② 計画段の不足（計画が危険）", f"{len(_cat2)}件")
        _m3.metric("③ 実態ズレ（実績のみ危険）", f"{len(_cat3)}件")
        _m4.metric("⚠ データ未整備（棚卸なし）", f"{len(_cat_d)}件",
                   help="棚卸openingが無く残が構造的にマイナス＝在庫として管理されていない（振替/IN加工等）。振り先はマスタ/データ整備（D系・情物一致の死角）。①②③からは除外。")
        st.caption(f"スキャン: {st.session_state.get('_dm_scanned_at', '')}　/　基準日 {_dm_today}　/　危険＝余裕<2日　/　①②③は棚卸opening有りの原料のみ")
        _show = pd.concat([
            _cat1.assign(緊急度='①最優先(要現物確認)'),
            _cat2.assign(緊急度='②計画段'),
            _cat3.assign(緊急度='③実態ズレ'),
        ], ignore_index=True)
        if _show.empty:
            st.success("✅ 在庫切れ緊急（①②③）に該当する原料はありません（棚卸opening有り原料）。")
        else:
            _multi = _show.groupby('原料名')['店舗'].nunique()
            _multi_names = _multi[_multi >= 2].index.tolist()
            if _multi_names:
                st.info(f"🔁 複数店で同時に緊急の原料（計画・マスタの構造問題シグナル）：{'、'.join(_multi_names[:10])}")
            _show = _show.sort_values(['緊急度', '実績余裕'])
            _disp = _show[['緊急度', '店舗', '原料名', '原料区分', '計画余裕', '実績余裕', '現在残_実績', '1日使用量', '原料JAN']].copy()
            for _c in ['計画余裕', '実績余裕', '現在残_実績']:
                _disp[_c] = _disp[_c].round(1)
            _disp['1日使用量'] = _disp['1日使用量'].round(2)
            st.dataframe(_disp, use_container_width=True, hide_index=True)
        # データ未整備（棚卸opening無）は別枠で（振り先＝マスタ/データ整備）
        if not _cat_d.empty:
            with st.expander(f"⚠ データ未整備（棚卸opening無）{len(_cat_d)}件 — 振り先：松本君（マスタ/データ整備・情物一致の死角）"):
                _dd = _cat_d.sort_values('実績余裕')[['店舗', '原料名', '原料区分', '計画余裕', '実績余裕', '原料JAN']].copy()
                for _c in ['計画余裕', '実績余裕']:
                    _dd[_c] = _dd[_c].round(1)
                st.dataframe(_dd, use_container_width=True, hide_index=True)

    st.divider()

    # ============================================================
    # Google Chat Webhook 設定
    # ============================================================
    st.markdown("### 💬 Google Chat 連携設定")
    st.caption("サマリータブから Google Chat にメッセージを送信する機能の設定です")
    
    current_webhook = load_webhook_url()
    
    if current_webhook:
        # 既存のURLは末尾だけ表示（セキュリティ）
        masked = current_webhook[:50] + "..." if len(current_webhook) > 50 else current_webhook
        st.success(f"✅ Webhook URL 設定済み：`{masked}`")
    else:
        st.info("ℹ️ Webhook URL は未設定です。設定するとサマリーをGoogle Chatに自動送信できます。")
    
    new_url = st.text_input(
        "Google Chat の Webhook URL",
        value=current_webhook or "",
        placeholder="https://chat.googleapis.com/v1/spaces/...",
        type='password' if current_webhook else 'default',
        help="Google Chat スペースで「アプリと統合」→「Webhook」から発行できます",
    )
    
    wcol1, wcol2, _wcol3 = st.columns([1, 1, 2])
    with wcol1:
        if st.button("💾 Webhook URLを保存", type='primary', use_container_width=True):
            if not new_url.strip():
                st.warning("⚠️ URLを入力してください")
            elif not new_url.startswith('https://chat.googleapis.com/'):
                st.error("❌ Google Chat の Webhook URL ではないようです（https://chat.googleapis.com/ で始まる必要があります）")
            else:
                if save_webhook_url(new_url.strip()):
                    st.success("✅ Webhook URL を保存しました")
                    st.rerun()
    with wcol2:
        if current_webhook:
            if st.button("🚫 設定を削除", use_container_width=True):
                try:
                    WEBHOOK_CONFIG_PATH.unlink()
                    st.success("✅ 設定を削除しました")
                    st.rerun()
                except Exception:
                    st.info("設定ファイルがありません")
    
    # テスト送信
    if current_webhook:
        with st.expander("🧪 テスト送信", expanded=False):
            st.caption("実際にメッセージを送信して、設定が正しいか確認できます")
            if st.button("テストメッセージを送信", key='_test_webhook'):
                test_msg = (
                    "✅ *在庫管理アプリ：テスト送信*\n\n"
                    "この設定で Google Chat にメッセージを送信できます。\n"
                    f"送信時刻：{datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')}"
                )
                with st.spinner("送信中..."):
                    result = send_to_google_chat(test_msg, current_webhook)
                if result is True:
                    st.success("✅ テスト送信成功！Google Chatを確認してください")
                else:
                    st.error(f"❌ {result}")
    
    # Webhook URL の取得方法
    with st.expander("❓ Webhook URL の取得方法", expanded=False):
        st.markdown("""
        **Google Chat スペースで Webhook を発行する手順：**
        
        1. 送信先にしたい Google Chat スペースを開く
        2. スペース名の右にある「▼」をクリック → 「アプリと統合」
        3. 「Webhook を追加」をクリック
        4. 名前（例：「在庫管理アプリ」）を入力して「保存」
        5. 表示された URL をコピーして上の入力欄に貼り付け
        
        ※ Google Workspace の管理者がWebhook機能を有効にしている必要があります。
        ※ 取得した URL は他人に教えないでください（誰でもメッセージを送れてしまいます）。
        """)
    
    st.divider()
    
    # ============================================================
    # 永続化ファイルの場所（参考情報）
    # ============================================================
    with st.expander("📂 永続化ファイルの場所（上級者向け）", expanded=False):
        st.code(f"""
データ本体: {SAVE_PATH}
ズレ補正値: {ADJUSTMENTS_PATH}
管理対象（共通）: {get_managed_jans_path(None)}
管理対象（店舗別の例: {selected_store}）: {get_managed_jans_path(selected_store)}
Webhook設定: {WEBHOOK_CONFIG_PATH}
        """.strip())
        st.caption(
            "これらのファイルはアプリのデータフォルダ（data/）に保存されます。"
            "バックアップしておくと、何かあったときに復元できます。"
        )
