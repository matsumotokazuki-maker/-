def load_webhook_url():
    """Google Chat の Webhook URL を読み込む（未設定なら None）"""
    import json
    if WEBHOOK_CONFIG_PATH.exists():
        try:
            with open(WEBHOOK_CONFIG_PATH, 'r', encoding='utf-8') as f:
                cfg = json.load(f)
                return cfg.get('url')
        except Exception:
            return None
    return None


def save_webhook_url(url):
    """Google Chat の Webhook URL を保存"""
    import json
    try:
        with open(WEBHOOK_CONFIG_PATH, 'w', encoding='utf-8') as f:
            json.dump({'url': url}, f, ensure_ascii=False, indent=2)
        return True
    except Exception as e:
        st.error(f"Webhook設定保存エラー: {e}")
        return False


def send_to_google_chat(message, webhook_url):
    """Google Chat にテキストメッセージを送信。
    成功すれば True、失敗すれば エラーメッセージ文字列。
    """
    import requests
    try:
        response = requests.post(
            webhook_url,
            json={'text': message},
            timeout=10,
        )
        if response.status_code == 200:
            return True
        else:
            return f"送信失敗（HTTP {response.status_code}）：{response.text[:200]}"
    except requests.exceptions.Timeout:
        return "送信失敗：タイムアウト（10秒）"
    except requests.exceptions.ConnectionError:
        return "送信失敗：接続エラー（ネットワークを確認してください）"
    except Exception as e:
        return f"送信失敗：{e}"


def get_managed_jans_path(store=None):
    """管理対象原料の設定ファイルパス。
    store指定があれば店舗別ファイル、なければ共通ファイル。
    """
    import json
    if store:
        # ファイル名に使えない文字を除去
        safe = "".join(c for c in store if c.isalnum() or c in ('-', '_'))
        return DATA_DIR / f'managed_jans_{safe}.json'
    return DATA_DIR / 'managed_jans_common.json'


def load_managed_jans(store=None):
    """管理対象JANの設定を読み込む。
    優先順位：店舗別 > 共通 > なし（全表示）。
    
    Returns:
        dict: {'jans': [...], 'description': '...'} または None（設定なし）
    """
    import json
    if store:
        store_path = get_managed_jans_path(store)
        if store_path.exists():
            try:
                with open(store_path, 'r', encoding='utf-8') as f:
                    return json.load(f)
            except Exception:
                pass
    common_path = get_managed_jans_path(None)
    if common_path.exists():
        try:
            with open(common_path, 'r', encoding='utf-8') as f:
                return json.load(f)
        except Exception:
            pass
    return None


def save_managed_jans(jans, store=None, description=''):
    """管理対象JANを設定ファイルに保存"""
    import json
    path = get_managed_jans_path(store)
    data = {
        'jans': list(jans),
        'description': description,
        'store': store or '共通',
    }
    try:
        with open(path, 'w', encoding='utf-8') as f:
            json.dump(data, f, ensure_ascii=False, indent=2)
        return True
    except Exception as e:
        st.error(f"設定保存エラー: {e}")
