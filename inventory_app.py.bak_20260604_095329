def delete_managed_jans(store=None):
    """管理対象JANの設定ファイルを削除（=フィルタ解除）"""
    path = get_managed_jans_path(store)
    if path.exists():
        try:
            path.unlink()
            return True
        except Exception:
            pass
    return False


